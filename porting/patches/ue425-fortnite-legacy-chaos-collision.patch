+		}
+		if (bGenerateMirroredCollision)
+		{
+			TArray<FVector> MirroredVertices = Vertices;
+			for (FVector& V : MirroredVertices) V.X = -V.X;
+			PxConvexMesh*& Mesh = Temp.Mirrored.AddDefaulted_GetRef();
+			if (Cooking->CreateConvex(Format, EPhysXMeshCookFlags::Default, MirroredVertices, Mesh)
