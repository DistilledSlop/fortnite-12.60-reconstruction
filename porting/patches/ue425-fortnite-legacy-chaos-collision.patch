+#include "CoreMinimal.h"
+
+#if WITH_PHYSX
+namespace physx { class PxTriangleMesh; }
+
+// These APIs are only for converted meshes with externally supplied mappings.
+// Register while holding a live mesh reference, before publishing any shapes.
+// Faces is indexed by PhysX internal face; INDEX_NONE is a valid mapped value.
+// Registration fails on duplicates or a size mismatch; data is copied and immutable.
+PHYSICSCORE_API bool RegisterFortniteLegacyTriangleFaceMap(physx::PxTriangleMesh& Mesh, const TArray<int32>& Faces, FString& Error);
+
+// True means this mesh is registered, including an invalid or out-of-range face.
+// Caller must hold a live mesh reference/shape and obey normal PhysX query locking.
+PHYSICSCORE_API bool TryGetFortniteLegacyTriangleFaceIndex(const physx::PxTriangleMesh& Mesh, uint32 InternalFace, uint32& OutFace);
+
+// Called by FPhysXAllocator before freeing its client pointer. Never dereferences it.
+PHYSICSCORE_API void UnregisterFortniteLegacyTriangleFaceMapAllocation(const void* Allocation);
+#endif
diff --git a/Engine/Source/Runtime/PhysicsCore/Private/FortniteLegacyPhysXFaceMap.cpp b/Engine/Source/Runtime/PhysicsCore/Private/FortniteLegacyPhysXFaceMap.cpp
new file mode 100644
index 000000000..5da6c999d
--- /dev/null
+++ b/Engine/Source/Runtime/PhysicsCore/Private/FortniteLegacyPhysXFaceMap.cpp
@@ -0,0 +1,83 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+#include "FortniteLegacyPhysXFaceMap.h"
+#if WITH_PHYSX
+#include "PhysXPublicCore.h"
+#include "HAL/CriticalSection.h"
+#include "Misc/ScopeLock.h"
+
+#include "HAL/ThreadSafeCounter.h"
+
+namespace
+{
+// Process-lifetime storage avoids shutdown-order dependencies with the allocator.
+// FMemory allocations used here do not route through FPhysXAllocator.
+struct FExternalFaceMapRegistry
+{
+    FCriticalSection Mutex;
+    TMap<const void*, TArray<int32>> Maps;
+};
+FThreadSafeCounter MapCount;
+FExternalFaceMapRegistry& GetRegistry()
+{
+    static FExternalFaceMapRegistry* Registry = new FExternalFaceMapRegistry();
+    return *Registry;
+}
+}
+
+void UnregisterFortniteLegacyTriangleFaceMapAllocation(const void* Allocation)
+{
+    if (!Allocation || MapCount.GetValue() == 0) return;
+    FExternalFaceMapRegistry& Registry = GetRegistry();
+    FScopeLock Lock(&Registry.Mutex);
+    if (Registry.Maps.Remove(Allocation)) MapCount.Decrement();
+}
+
+bool RegisterFortniteLegacyTriangleFaceMap(physx::PxTriangleMesh& Mesh, const TArray<int32>& Faces, FString& Error)
+{
+    // Only owned meshes created by this SDK's normal triangle factory qualify;
+    // in-place deserialized meshes are not independently allocator-owned.
+    if (!(Mesh.getBaseFlags() & physx::PxBaseFlag::eOWNS_MEMORY))
+    {
+        Error = TEXT("In-place PhysX meshes cannot have legacy face maps");
+        return false;
+    }
+    // The caller keeps a reference alive until registration completes.
+    if (Mesh.getNbTriangles() != static_cast<uint32>(Faces.Num()))
+    {
+        Error = TEXT("External face map count does not match the PhysX mesh");
+        return false;
+    }
+    for (int32 Face : Faces)
+    {
+        if (Face < INDEX_NONE)
+        {
+            Error = TEXT("Invalid external face index");
+            return false;
+        }
+    }
+    const void* Key = static_cast<const void*>(&Mesh);
+    FExternalFaceMapRegistry& Registry = GetRegistry();
+    FScopeLock Lock(&Registry.Mutex);
+    if (Registry.Maps.Contains(Key))
+    {
+        Error = TEXT("External face map mesh already registered");
+        return false;
+    }
+    Registry.Maps.Add(Key, Faces);
+    MapCount.Increment();
+    return true;
+}
+
+bool TryGetFortniteLegacyTriangleFaceIndex(const physx::PxTriangleMesh& Mesh, uint32 InternalFace, uint32& OutFace)
+{
+    const void* Key = static_cast<const void*>(&Mesh);
+    FExternalFaceMapRegistry& Registry = GetRegistry();
+    FScopeLock Lock(&Registry.Mutex);
+    const TArray<int32>* Faces = Registry.Maps.Find(Key);
+    if (!Faces) return false;
+    OutFace = InternalFace < static_cast<uint32>(Faces->Num())
+        ? static_cast<uint32>((*Faces)[static_cast<int32>(InternalFace)])
+        : static_cast<uint32>(INDEX_NONE);
+    return true;
+}
+#endif
