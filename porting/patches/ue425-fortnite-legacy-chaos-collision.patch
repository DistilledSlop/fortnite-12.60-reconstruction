+bool UBodySetup::InstallFortniteOriginalChaos(FByteBulkData& Bulk, FString& Error)
+{
+	auto Fail = [&Error](const TCHAR* Reason) { Error = Reason; return false; };
+	if (Bulk.IsLocked() || Bulk.GetBulkDataSize() <= 0)
+	{
+		return Fail(TEXT("cooked bulk is empty or already locked"));
+	}
+
+	// Parse + PhysX cooking happen once per distinct payload and are cached on disk (FortniteCollisionCache);
+	// here we only turn cached cooked buffers into PhysX objects.
+	TSharedPtr<const FortniteCollisionCache::FBlob> Blob;
+	{
+		const int64 Size = Bulk.GetBulkDataSize();
+		const uint8* Bytes = static_cast<const uint8*>(Bulk.LockReadOnly());
+		const bool bAcquired = Bytes && FortniteCollisionCache::Acquire(Bytes, Size, Blob, Error);
+		Bulk.Unlock(); // FinishCreatingPhysicsMeshes can flush this bulk.
+		if (!bAcquired || !Blob.IsValid())
+		{
+			if (Error.IsEmpty()) Error = TEXT("unable to lock cooked bulk");
+			return false;
+		}
+	}
+	if (!Blob->bOk)
+	{
+		Error = Blob->Error;
+		return false;
+	}
+
+	const bool bSimple = GetCollisionTraceFlag() != CTF_UseComplexAsSimple;
+	const int32 NumConvex = bSimple ? AggGeom.ConvexElems.Num() : 0;
+	// Original 14444e0d0 installs the first N objects and releases extras. The
+	// sidewalk has ONE element and TWO identical cooked hulls, not two elements.
+	if (Blob->Convexes.Num() < NumConvex)
+		return Fail(TEXT("fewer cooked convexes than aggregate elements"));
+	if (NumConvex && !bGenerateNonMirroredCollision && !bGenerateMirroredCollision)
+		return Fail(TEXT("convex elements have no enabled PhysX output"));
+	for (int32 I = 0; I < NumConvex; ++I)
+	{
+		const FortniteCollisionCache::FConvexBlob& C = Blob->Convexes[I];
+		if (!C.bDoCollide)
+			return Fail(TEXT("missing or disabled aggregate convex"));
+		if ((bGenerateNonMirroredCollision && !C.bNormalOk) || (bGenerateMirroredCollision && !C.bMirroredOk))
+			return Fail(TEXT("convex cooking failed"));
+	}
+	if (!GPhysXSDK)
+		return Fail(TEXT("PhysX SDK is unavailable"));
+
+	struct FTemporaryMeshes
+	{
+		TArray<PxConvexMesh*> Normal, Mirrored;
+		TArray<PxTriangleMesh*> Triangles;
+		~FTemporaryMeshes()
+		{
+			for (auto* Mesh : Normal) if (Mesh) Mesh->release();
+			for (auto* Mesh : Mirrored) if (Mesh) Mesh->release();
+			for (auto* Mesh : Triangles) if (Mesh) Mesh->release();
+		}
+		void Transfer() { Normal.Empty(); Mirrored.Empty(); Triangles.Empty(); }
+	} Temp;
+	for (int32 I = 0; I < NumConvex; ++I)
+	{
+		// Cooked hulls already contain element-to-body transforms. Stock PhysX
+		// shapes also use body-space hulls; do not transform these vertices again.
+		const FortniteCollisionCache::FConvexBlob& C = Blob->Convexes[I];
+		if (bGenerateNonMirroredCollision)
+		{
+			FPhysXInputStream Stream(C.Normal.GetData(), C.Normal.Num());
+			PxConvexMesh* Mesh = GPhysXSDK->createConvexMesh(Stream);
+			Temp.Normal.Add(Mesh);
+			if (!Mesh) return Fail(TEXT("cached convex mesh could not be created"));
+		}
+		if (bGenerateMirroredCollision)
+		{
+			FPhysXInputStream Stream(C.Mirrored.GetData(), C.Mirrored.Num());
+			PxConvexMesh* Mesh = GPhysXSDK->createConvexMesh(Stream);
+			Temp.Mirrored.Add(Mesh);
+			if (!Mesh) return Fail(TEXT("cached mirrored convex mesh could not be created"));
+		}
+	}
+
+	for (const FortniteCollisionCache::FTriangleBlob& Tri : Blob->Triangles)
+	{
+		FPhysXInputStream Stream(Tri.Cooked.GetData(), Tri.Cooked.Num());
+		PxTriangleMesh* Mesh = GPhysXSDK->createTriangleMesh(Stream);
+		Temp.Triangles.Add(Mesh);
+		if (!Mesh || !Mesh->getNbTriangles() || Mesh->getNbTriangles() != static_cast<PxU32>(Tri.Faces.Num()))
+			return Fail(TEXT("cached triangle mesh could not be created"));
+	}
+	// Nothing is published until every mesh and mapping is ready. Failed
+	// registration releases temporary meshes and removes their maps before free.
+	for (int32 I = 0; I < Temp.Triangles.Num(); ++I)
+		if (!RegisterFortniteLegacyTriangleFaceMap(*Temp.Triangles[I], Blob->Triangles[I].Faces, Error)) return false;
+
+	FinishCreatingPhysicsMeshes_PhysX(Temp.Normal, Temp.Mirrored, Temp.Triangles);
+	Temp.Transfer();
+	UVInfo.IndexBuffer = Blob->UVIndices;
+	UVInfo.VertPositions = Blob->UVPositions;
+	UVInfo.VertUVs = Blob->UVChannels;
+	FaceRemap = Blob->FaceRemap;
+	bFailedToCreatePhysicsMeshes = false;
+	UE_LOG(LogPhysics, Verbose, TEXT("Installed original Chaos collision for %s: %d convex elements, %d triangle meshes"),
+		*GetPathName(), NumConvex, Blob->Triangles.Num());
+	return true;
+}
