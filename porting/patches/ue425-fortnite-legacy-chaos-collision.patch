+		if (!Cooking->CreateTriMesh(Format, Flags, Source->Vertices, Indices,
+			Source->MaterialIndices, false, Mesh) || !Mesh || !Mesh->getNbTriangles())
+			return Fail(TEXT("triangle mesh cooking failed"));
