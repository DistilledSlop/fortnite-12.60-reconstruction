@@ -0,0 +1,286 @@
+#pragma once
+#include "CoreMinimal.h"
+
+// Original Fortnite 12.60 buffer archive: float precision 4, ExternalPhysics 37,
+// Destruction 10. These versions belong to the fresh archive, not the package.
+// No coordinate conversion is applied. Geometry remains in body space.
+namespace FortniteLegacyChaos
+{
+struct FConvex { TArray<FVector> Vertices; bool bDoCollide = true; };
+struct FTriangleMesh
+{
+    TArray<FVector> Vertices;
+    TArray<FIntVector> Triangles;
+    TArray<uint16> MaterialIndices;
+    TArray<int32> ExternalFaceIndexMap;
+    bool bDoCollide = true;
+};
+struct FData
+{
+    TArray<TSharedPtr<FConvex>> Convexes;
+    TArray<TSharedPtr<FTriangleMesh>> TriangleMeshes;
+    TArray<int32> UVIndices;
+    TArray<FVector> UVPositions;
+    TArray<TArray<FVector2D>> UVChannels;
+    TArray<int32> FaceRemap;
+};
+namespace Private
+{
+class FReader
+{
+    const uint8* Bytes;
+    int64 Size, Offset = 0, Allocated = 0;
+    FString& Error;
+    // Explicit resource limits, independent of the untrusted wire counts.
+    static constexpr int32 MaxCount = 1024 * 1024;
+    static constexpr int64 MaxAllocation = 256LL * 1024 * 1024;
+    struct FEntry { uint8 Type = 0; TSharedPtr<FConvex> Convex; TSharedPtr<FTriangleMesh> Mesh; };
+    TMap<int32, FEntry> Objects;
+    struct FNode { int32 A, B; bool Leaf; bool EmptyA, EmptyB, OrderedA, OrderedB; };
+    bool Fail(const TCHAR* Why)
+    {
+        if (Error.IsEmpty()) Error = FString::Printf(TEXT("Original Chaos at byte %lld: %s"), (long long)Offset, Why);
+        return false;
+    }
+    bool Need(int64 N) { return N >= 0 && N <= Size - Offset ? true : Fail(TEXT("truncated payload")); }
+    bool Budget(int64 N)
+    {
+        if (N < 0 || N > MaxAllocation - Allocated) return Fail(TEXT("allocation budget exceeded"));
+        Allocated += N; return true;
+    }
+    bool U8(uint8& V) { if (!Need(1)) return false; V = Bytes[Offset++]; return true; }
+    bool U16(uint16& V)
+    {
+        if (!Need(2)) return false;
+        V = uint16(Bytes[Offset]) | (uint16(Bytes[Offset+1]) << 8); Offset += 2; return true;
+    }
+    bool U32(uint32& V)
+    {
+        if (!Need(4)) return false;
+        V = uint32(Bytes[Offset]) | (uint32(Bytes[Offset+1]) << 8) |
+            (uint32(Bytes[Offset+2]) << 16) | (uint32(Bytes[Offset+3]) << 24);
+        Offset += 4; return true;
+    }
+    bool I32(int32& V) { uint32 U; if (!U32(U)) return false; FMemory::Memcpy(&V, &U, 4); return true; }
+    bool Float(float& V)
+    {
+        uint32 U; if (!U32(U)) return false; FMemory::Memcpy(&V, &U, 4);
+        return FMath::IsFinite(V) ? true : Fail(TEXT("nonfinite float"));
+    }
+    bool Bool(bool& V)
+    {
+        uint32 U; if (!U32(U)) return false;
+        if (U > 1) return Fail(TEXT("invalid uint32 boolean"));
+        V = U != 0; return true;
+    }
+    bool Count(int32& N, int64 WireStride, int64 MemoryStride = 0)
+    {
+        if (!I32(N)) return false;
+        if (N < 0 || N > MaxCount) return Fail(TEXT("array count exceeds bounds"));
+        if (WireStride <= 0 || N > (Size - Offset) / WireStride) return Fail(TEXT("array exceeds remaining payload"));
+        return Budget(int64(N) * MemoryStride);
+    }
+    bool Vec(FVector& V)
+    {
+        float X,Y,Z; if (!Float(X) || !Float(Y) || !Float(Z)) return false; V = FVector(X,Y,Z); return true;
+    }
+    // Reads an AABB without validating it. The serialized AABB tree is discarded by this importer, and the original
+    // cook leaves stale/uninitialized bytes in unused tree fields (full bounds of some trees, child bounds and the second
+    // child index of leaf nodes), so ordering is only enforced where the field is meaningful (internal nodes, mesh/convex bounds).
+    bool RawBounds(bool& Empty, bool& Ordered)
+    {
+        FVector Min,Max; if (!Vec(Min) || !Vec(Max)) return false;
+        const float Limit = 3.4028234663852886e38f;
+        Empty = Min.X == Limit && Min.Y == Limit && Min.Z == Limit && Max.X == -Limit && Max.Y == -Limit && Max.Z == -Limit;
+        Ordered = Min.X <= Max.X && Min.Y <= Max.Y && Min.Z <= Max.Z;
+        return true;
+    }
+    bool Bounds(bool* Empty = nullptr)
+    {
+        FVector Min,Max; if (!Vec(Min) || !Vec(Max)) return false;
+        // Chaos TAABB's default/empty state is (+FLT_MAX, -FLT_MAX).
+        const float Limit = 3.4028234663852886e38f;
+        const bool IsEmpty = Min.X == Limit && Min.Y == Limit && Min.Z == Limit &&
+            Max.X == -Limit && Max.Y == -Limit && Max.Z == -Limit;
+        if (Empty) *Empty = IsEmpty;
+        return (Empty && IsEmpty) || (Min.X <= Max.X && Min.Y <= Max.Y && Min.Z <= Max.Z)
+            ? true : Fail(TEXT("inverted bounds"));
+    }
+    bool Vectors(TArray<FVector>& A)
+    {
+        int32 N; if (!Count(N,12,sizeof(FVector))) return false; A.SetNum(N);
+        for (FVector& V : A) if (!Vec(V)) return false;
+        return true;
+    }
+    bool Ints(TArray<int32>& A)
+    {
+        int32 N; if (!Count(N,4,sizeof(int32))) return false; A.SetNum(N);
+        for (int32& V : A) if (!I32(V)) return false;
+        return true;
+    }
+    bool Particles(TArray<FVector>& A) { bool View; return Bool(View) && Vectors(A); }
+    bool Flags() { bool Convex, StoredCollide; return Bool(Convex) && Bool(StoredCollide); }
+    bool ConvexBody(FConvex& C)
+    {
+        if (!Flags()) return false;
+        int32 N; if (!Count(N,24)) return false;
+        for (int32 I=0; I<N; ++I)
+        {
+            FVector Origin, Normal;
+            if (!Vec(Origin) || !Vec(Normal)) return false;
+            if (Normal.X == 0 && Normal.Y == 0 && Normal.Z == 0) return Fail(TEXT("zero convex plane normal"));
+        }
+        float Volume; FVector Center;
+        if (!Particles(C.Vertices) || !Bounds() || !Float(Volume) || !Vec(Center)) return false;
+        if (N < 4 || Volume < 0 || C.Vertices.Num() < 4) return Fail(TEXT("invalid convex geometry"));
+        C.bDoCollide = true; // 1437feff0: Destruction < 11 overrides the stored value.
+        return true;
+    }
+    bool Payloads(int32 Triangles, int32* OutCount = nullptr)
+    {
+        int32 N; if (!Count(N,28)) return false; if (OutCount) *OutCount=N;
+        for (int32 I=0; I<N; ++I)
+        {
+            int32 P; if (!I32(P) || !Bounds()) return false;
+            if (P < 0 || P >= Triangles) return Fail(TEXT("BVH payload index out of range"));
+        }
+        return true;
+    }
+    bool Tree(int32 Triangles)
+    {
+        { bool E, O; if (!RawBounds(E, O)) return false; } // tree FullBounds: unused by this importer, may be stale (LootCrate, RockPile_02)
+        int32 N; if (!Count(N,60,sizeof(FNode))) return false;
+        TArray<FNode> Nodes; Nodes.SetNum(N);
+        for (FNode& Node : Nodes)
+            if (!RawBounds(Node.EmptyA, Node.OrderedA) || !RawBounds(Node.EmptyB, Node.OrderedB) || !I32(Node.A) || !I32(Node.B) || !Bool(Node.Leaf)) return false;
+        int32 Leaves; if (!Count(Leaves,4)) return false;
+        for (int32 I=0; I<Leaves; ++I) if (!Payloads(Triangles)) return false;
+        for (const FNode& Node : Nodes)
+        {
+            if (Node.Leaf) continue; // leaf nodes: only the leaf index in A is meaningful and it is not used (tree discarded)
+            if (Node.EmptyA || Node.EmptyB) return Fail(TEXT("empty internal BVH child bounds"));
+            if (!Node.OrderedA || !Node.OrderedB) return Fail(TEXT("inverted bounds"));
+            const int32 Limit = N;
+            if (Node.A < -1 || Node.A >= Limit || Node.B < -1 || Node.B >= Limit)
+                return Fail(TEXT("BVH child index out of range"));
+        }
+        int32 Dirty,Global;
+        if (!Payloads(Triangles,&Dirty) || !Payloads(Triangles,&Global)) return false;
+        bool HasMap; if (!Bool(HasMap)) return false;
+        if (HasMap)
+        {
+            // 1437fc6d0 serializes all keys first, then three ints per key.
+            int32 K; if (!Count(K,16,64)) return false;
+            TSet<int32> Keys;
+            for (int32 I=0; I<K; ++I)
+            {
+                int32 Key; if (!I32(Key)) return false;
+                if (Key < 0 || Key >= Triangles || Keys.Contains(Key)) return Fail(TEXT("invalid BVH map key"));
+                Keys.Add(Key);
+            }
+            for (int32 I=0; I<K; ++I)
+            {
+                int32 G,D,L; if (!I32(G) || !I32(D) || !I32(L)) return false;
+                if (G < -1 || G >= Global || D < -1 || D >= Dirty || L < -1 || L >= Leaves)
+                    return Fail(TEXT("BVH payload info index out of range"));
+            }
+        }
+        int32 Children,Depth; float MaxBounds;
+        if (!I32(Children) || !I32(Depth) || !Float(MaxBounds)) return false;
+        return Children >= 0 && Depth >= 0 && MaxBounds >= 0 ? true : Fail(TEXT("invalid BVH settings"));
+    }
+    bool MeshBody(FTriangleMesh& M)
+    {
+        if (!Flags() || !Particles(M.Vertices)) return false;
+        bool Large; int32 N;
+        if (!Bool(Large) || !Count(N,Large ? 12 : 6,sizeof(FIntVector))) return false;
+        M.Triangles.SetNum(N);
+        for (FIntVector& T : M.Triangles)
+        {
+            if (Large) { if (!I32(T.X) || !I32(T.Y) || !I32(T.Z)) return false; }
+            else { uint16 A,B,C; if (!U16(A) || !U16(B) || !U16(C)) return false; T = FIntVector(A,B,C); }
+            if (T.X < 0 || T.Y < 0 || T.Z < 0 || T.X >= M.Vertices.Num() || T.Y >= M.Vertices.Num() || T.Z >= M.Vertices.Num())
+                return Fail(TEXT("triangle vertex index out of range"));
+        }
+        if (!Bounds() || !Tree(M.Triangles.Num()) || !Count(N,2,sizeof(uint16))) return false;
+        M.MaterialIndices.SetNum(N);
+        for (uint16& V : M.MaterialIndices) if (!U16(V)) return false;
+        if (!Ints(M.ExternalFaceIndexMap)) return false;
+        if ((N != 0 && N != M.Triangles.Num()) ||
+            (M.ExternalFaceIndexMap.Num() != 0 && M.ExternalFaceIndexMap.Num() != M.Triangles.Num()))
+            return Fail(TEXT("triangle material/face map cardinality mismatch"));
+        for (int32 I : M.ExternalFaceIndexMap) if (I < -1) return Fail(TEXT("invalid external face index"));
+        M.bDoCollide = true;
+        return true;
+    }
+    bool Pointer(uint8 Expected, FEntry& Out)
+    {
+        bool Present; if (!Bool(Present)) return false;
+        if (!Present) { Out = FEntry(); return true; }
+        int32 Id; if (!I32(Id)) return false;
+        if (Id < 0 || Id >= MaxCount) return Fail(TEXT("object identity exceeds bounds"));
+        if (const FEntry* Existing = Objects.Find(Id))
+        {
+            if (Existing->Type != Expected) return Fail(TEXT("object reference has incompatible type"));
+            Out = *Existing; return true;
+        }
+        uint8 Type; if (!U8(Type)) return false;
+        if (Type != 8 && Type != 11) return Fail(TEXT("unsupported implicit type (only plain convex 8 and triangle 11 supported)"));
+        if (Type != Expected) return Fail(TEXT("object type incompatible with containing array"));
+        if (!Budget(256)) return false;
+        Out.Type=Type;
+        if (Type == 8)
+        {
+            Out.Convex = MakeShared<FConvex>();
+            if (!ConvexBody(*Out.Convex)) return false;
+        }
+        else
+        {
+            Out.Mesh = MakeShared<FTriangleMesh>();
+            if (!MeshBody(*Out.Mesh)) return false;
+        }
+        Objects.Add(Id,Out); return true;
+    }
+public:
+    FReader(const uint8* In, int64 InSize, FString& InError) : Bytes(In), Size(InSize), Error(InError) {}
+    bool Parse(FData& Out)
+    {
+        if (!Bytes || Size < 4 || Size > 512LL * 1024 * 1024) return Fail(TEXT("invalid input buffer or payload size limit"));
+        int32 Precision,N; if (!I32(Precision)) return false;
+        if (Precision != 4) return Fail(TEXT("unsupported scalar precision"));
+        if (!Count(N,4,sizeof(TSharedPtr<FConvex>))) return false;
+        Out.Convexes.SetNum(N);
+        for (auto& C : Out.Convexes) { FEntry E; if (!Pointer(8,E)) return false; C=E.Convex; }
+        if (!Count(N,4,sizeof(TSharedPtr<FTriangleMesh>))) return false;
+        Out.TriangleMeshes.SetNum(N);
+        for (auto& M : Out.TriangleMeshes) { FEntry E; if (!Pointer(11,E)) return false; M=E.Mesh; }
+        if (!Ints(Out.UVIndices) || !Vectors(Out.UVPositions)) return false;
+        if (!Count(N,4,sizeof(TArray<FVector2D>))) return false;
+        Out.UVChannels.SetNum(N);
+        // 144444eb0 -> 141540b90 -> 140e1ff50: nested count + float2 pairs.
+        for (auto& Channel : Out.UVChannels)
+        {
+            int32 NumUV; if (!Count(NumUV,8,sizeof(FVector2D))) return false;
+            Channel.SetNum(NumUV);
+            for (FVector2D& V : Channel)
+            { float X,Y; if (!Float(X) || !Float(Y)) return false; V=FVector2D(X,Y); }
+            if (NumUV != Out.UVPositions.Num()) return Fail(TEXT("UV channel/position cardinality mismatch"));
+        }
+        for (int32 I : Out.UVIndices) if (I < 0 || I >= Out.UVPositions.Num()) return Fail(TEXT("UV position index out of range"));
+        if (Out.UVIndices.Num() % 3 != 0) return Fail(TEXT("UV index count is not triangular"));
+        if (!Ints(Out.FaceRemap)) return false;
+        for (int32 I : Out.FaceRemap) if (I < -1) return Fail(TEXT("invalid face remap index"));
+        return Offset == Size ? true : Fail(TEXT("trailing payload bytes"));
+    }
+};
+}
+inline bool Read(const uint8* Data, int64 Size, FData& Out, FString& Error)
+{
+    Error.Empty();
+    FData Candidate;
+    Private::FReader Reader(Data,Size,Error);
+    if (!Reader.Parse(Candidate)) return false;
+    Out=MoveTemp(Candidate);
+    return true;
+}
+}
diff --git a/Engine/Source/Runtime/PhysicsCore/Public/FortniteLegacyPhysXFaceMap.h b/Engine/Source/Runtime/PhysicsCore/Public/FortniteLegacyPhysXFaceMap.h
new file mode 100644
index 000000000..fefcd47df
--- /dev/null
+++ b/Engine/Source/Runtime/PhysicsCore/Public/FortniteLegacyPhysXFaceMap.h
@@ -0,0 +1,21 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+#pragma once
+
+#include "CoreMinimal.h"
+
+#if WITH_PHYSX
+namespace physx { class PxTriangleMesh; }
+
+// These APIs are only for converted meshes with externally supplied mappings.
+// Register while holding a live mesh reference, before publishing any shapes.
+// Faces is indexed by PhysX internal face; INDEX_NONE is a valid mapped value.
+// Registration fails on duplicates or a size mismatch; data is copied and immutable.
+PHYSICSCORE_API bool RegisterFortniteLegacyTriangleFaceMap(physx::PxTriangleMesh& Mesh, const TArray<int32>& Faces, FString& Error);
+
+// True means this mesh is registered, including an invalid or out-of-range face.
+// Caller must hold a live mesh reference/shape and obey normal PhysX query locking.
+PHYSICSCORE_API bool TryGetFortniteLegacyTriangleFaceIndex(const physx::PxTriangleMesh& Mesh, uint32 InternalFace, uint32& OutFace);
+
+// Called by FPhysXAllocator before freeing its client pointer. Never dereferences it.
+PHYSICSCORE_API void UnregisterFortniteLegacyTriangleFaceMapAllocation(const void* Allocation);
+#endif
diff --git a/Engine/Source/Runtime/PhysicsCore/Private/FortniteLegacyPhysXFaceMap.cpp b/Engine/Source/Runtime/PhysicsCore/Private/FortniteLegacyPhysXFaceMap.cpp
new file mode 100644
index 000000000..5da6c999d
--- /dev/null
+++ b/Engine/Source/Runtime/PhysicsCore/Private/FortniteLegacyPhysXFaceMap.cpp
@@ -0,0 +1,83 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+#include "FortniteLegacyPhysXFaceMap.h"
+#if WITH_PHYSX
+#include "PhysXPublicCore.h"
+#include "HAL/CriticalSection.h"
+#include "Misc/ScopeLock.h"
+
+#include "HAL/ThreadSafeCounter.h"
+
+namespace
+{
+// Process-lifetime storage avoids shutdown-order dependencies with the allocator.
+// FMemory allocations used here do not route through FPhysXAllocator.
+struct FExternalFaceMapRegistry
+{
+    FCriticalSection Mutex;
+    TMap<const void*, TArray<int32>> Maps;
+};
+FThreadSafeCounter MapCount;
+FExternalFaceMapRegistry& GetRegistry()
+{
+    static FExternalFaceMapRegistry* Registry = new FExternalFaceMapRegistry();
+    return *Registry;
+}
+}
+
+void UnregisterFortniteLegacyTriangleFaceMapAllocation(const void* Allocation)
+{
+    if (!Allocation || MapCount.GetValue() == 0) return;
+    FExternalFaceMapRegistry& Registry = GetRegistry();
+    FScopeLock Lock(&Registry.Mutex);
+    if (Registry.Maps.Remove(Allocation)) MapCount.Decrement();
+}
+
+bool RegisterFortniteLegacyTriangleFaceMap(physx::PxTriangleMesh& Mesh, const TArray<int32>& Faces, FString& Error)
+{
+    // Only owned meshes created by this SDK's normal triangle factory qualify;
+    // in-place deserialized meshes are not independently allocator-owned.
+    if (!(Mesh.getBaseFlags() & physx::PxBaseFlag::eOWNS_MEMORY))
+    {
+        Error = TEXT("In-place PhysX meshes cannot have legacy face maps");
+        return false;
+    }
+    // The caller keeps a reference alive until registration completes.
+    if (Mesh.getNbTriangles() != static_cast<uint32>(Faces.Num()))
+    {
+        Error = TEXT("External face map count does not match the PhysX mesh");
+        return false;
+    }
+    for (int32 Face : Faces)
+    {
+        if (Face < INDEX_NONE)
+        {
+            Error = TEXT("Invalid external face index");
+            return false;
+        }
+    }
+    const void* Key = static_cast<const void*>(&Mesh);
+    FExternalFaceMapRegistry& Registry = GetRegistry();
+    FScopeLock Lock(&Registry.Mutex);
+    if (Registry.Maps.Contains(Key))
+    {
+        Error = TEXT("External face map mesh already registered");
+        return false;
+    }
+    Registry.Maps.Add(Key, Faces);
+    MapCount.Increment();
+    return true;
+}
+
+bool TryGetFortniteLegacyTriangleFaceIndex(const physx::PxTriangleMesh& Mesh, uint32 InternalFace, uint32& OutFace)
+{
+    const void* Key = static_cast<const void*>(&Mesh);
+    FExternalFaceMapRegistry& Registry = GetRegistry();
+    FScopeLock Lock(&Registry.Mutex);
+    const TArray<int32>* Faces = Registry.Maps.Find(Key);
+    if (!Faces) return false;
+    OutFace = InternalFace < static_cast<uint32>(Faces->Num())
+        ? static_cast<uint32>((*Faces)[static_cast<int32>(InternalFace)])
+        : static_cast<uint32>(INDEX_NONE);
+    return true;
+}
+#endif
diff --git a/Engine/Source/Runtime/Engine/Private/PhysicsEngine/FortniteCollisionCache.h b/Engine/Source/Runtime/Engine/Private/PhysicsEngine/FortniteCollisionCache.h
new file mode 100644
index 000000000..6a88d5509
--- /dev/null
+++ b/Engine/Source/Runtime/Engine/Private/PhysicsEngine/FortniteCollisionCache.h
@@ -0,0 +1,49 @@
+// Persistent cache of PhysX-cooked data derived from original Fortnite (Chaos) cooked collision payloads.
+// The original payload is parsed and cooked by PhysX once; afterwards a body only creates PhysX objects from the cached
+// cooked buffers. Keyed by SHA1 of the exact payload bytes, so it is valid for every body that embeds the same payload.
+#pragma once
+
+#include "CoreMinimal.h"
+
+#if WITH_PHYSX && PHYSICS_INTERFACE_PHYSX
+
+namespace FortniteCollisionCache
+{
+	struct FConvexBlob
+	{
+		bool bDoCollide = false;      // false: null/disabled element in the original payload
+		bool bNormalOk = false;       // cooked successfully (inflation accepted)
+		bool bMirroredOk = false;
+		TArray<uint8> Normal;
+		TArray<uint8> Mirrored;
+	};
+
+	struct FTriangleBlob
+	{
+		TArray<uint8> Cooked;
+		TArray<int32> Faces;          // per PhysX internal face: external face index (INDEX_NONE allowed)
+	};
+
+	struct FBlob
+	{
+		bool bOk = false;             // false: deterministic failure, Error says why
+		FString Error;
+		TArray<FConvexBlob> Convexes;
+		TArray<FTriangleBlob> Triangles;
+		TArray<int32> UVIndices;
+		TArray<FVector> UVPositions;
+		TArray<TArray<FVector2D>> UVChannels;
+		TArray<int32> FaceRemap;
+	};
+
+	// Thread-safe. Returns false only when the result could not be determined (cooking unavailable); Error is set then.
+	// Otherwise OutBlob is set and OutBlob->bOk tells whether the payload is usable.
+	ENGINE_API bool Acquire(const uint8* Bytes, int64 Size, TSharedPtr<const FBlob>& OutBlob, FString& OutError);
+
+	// Parallel bake of every inline original payload found in the .uexp files under ContentDir.
+	ENGINE_API void BakeContent(const FString& ContentDir);
+
+	ENGINE_API void LogStats(const TCHAR* Context);
+}
+
+#endif
diff --git a/Engine/Source/Runtime/Engine/Private/PhysicsEngine/FortniteCollisionCache.cpp b/Engine/Source/Runtime/Engine/Private/PhysicsEngine/FortniteCollisionCache.cpp
new file mode 100644
index 000000000..0e7cf8cef
--- /dev/null
+++ b/Engine/Source/Runtime/Engine/Private/PhysicsEngine/FortniteCollisionCache.cpp
@@ -0,0 +1,383 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+#include "FortniteCollisionCache.h"
+
+#if WITH_PHYSX && PHYSICS_INTERFACE_PHYSX
+
+#include "Async/ParallelFor.h"
+#include "HAL/FileManager.h"
+#include "HAL/PlatformProperties.h"
+#include "HAL/PlatformTime.h"
+#include "Misc/CommandLine.h"
+#include "Misc/DelayedAutoRegister.h"
+#include "Misc/FileHelper.h"
+#include "Misc/Guid.h"
+#include "Misc/Parse.h"
+#include "Misc/Paths.h"
+#include "Misc/SecureHash.h"
+#include "Serialization/MemoryReader.h"
+#include "Serialization/MemoryWriter.h"
+#include "PhysicsPublicCore.h"
+#include "IPhysXCookingModule.h"
+#include "IPhysXCooking.h"
+#include "Interface_CollisionDataProviderCore.h"
+#include "PhysXPublic.h"
+#include "PhysicsEngine/PhysXSupport.h"
+#include "FortniteLegacyChaosCookedData.h"
+
+DEFINE_LOG_CATEGORY_STATIC(LogFortniteCollisionCache, Log, All);
+
+namespace FortniteCollisionCache
+{
+namespace
+{
+	constexpr uint32 Magic = 0x31434346; // 'FCC1'
+	constexpr int32 FormatVersion = 1;   // bump when the blob layout or the cooking recipe here changes
+
+	FThreadSafeCounter GHits, GMisses, GNegative, GCookFailed, GWritten;
+	FThreadSafeCounter64 GCookMicros, GLoadMicros;
+	// PhysX object creation from a stream is used concurrently by stock UE async cooking, but is serialized here to be safe.
+	FCriticalSection GPhysXCreateLock;
+
+	const FString& CacheDir()
+	{
+		static const FString Dir = []()
+		{
+			FString Override;
+			if (FParse::Value(FCommandLine::Get(), TEXT("-FortniteCollisionCache="), Override) && !Override.IsEmpty())
+			{
+				return FPaths::ConvertRelativePathToFull(Override);
+			}
+			return FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir() / TEXT("FortniteCollisionCache"));
+		}();
+		return Dir;
+	}
+
+	FString KeyFor(const uint8* Bytes, int64 Size)
+	{
+		uint8 Hash[20];
+		FSHA1::HashBuffer(Bytes, static_cast<uint32>(Size), Hash);
+		return BytesToHex(Hash, 20);
+	}
+
+	FString PathFor(const FString& Key)
+	{
+		return CacheDir() / Key.Left(2) / (Key + TEXT(".fcc"));
+	}
+
+	bool IsDisabled()
+	{
+		static const bool bDisabled = FParse::Param(FCommandLine::Get(), TEXT("FortniteNoCollisionCache"));
+		return bDisabled;
+	}
+
+	void Serialize(FArchive& Ar, FBlob& B)
+	{
+		Ar << B.bOk << B.Error;
+		int32 NumConvex = B.Convexes.Num();
+		Ar << NumConvex;
+		if (Ar.IsLoading()) B.Convexes.SetNum(NumConvex);
+		for (FConvexBlob& C : B.Convexes)
+		{
+			Ar << C.bDoCollide << C.bNormalOk << C.bMirroredOk << C.Normal << C.Mirrored;
+		}
+		int32 NumTri = B.Triangles.Num();
+		Ar << NumTri;
+		if (Ar.IsLoading()) B.Triangles.SetNum(NumTri);
+		for (FTriangleBlob& T : B.Triangles)
+		{
+			Ar << T.Cooked << T.Faces;
+		}
+		Ar << B.UVIndices << B.UVPositions << B.UVChannels << B.FaceRemap;
+	}
+
+	bool TryLoad(const FString& Path, uint16 CookVersion, TSharedPtr<FBlob>& Out)
+	{
+		TArray<uint8> Bytes;
+		if (!FFileHelper::LoadFileToArray(Bytes, *Path, FILEREAD_Silent) || Bytes.Num() < 16)
+		{
+			return false;
+		}
+		FMemoryReader Ar(Bytes);
+		uint32 FileMagic = 0; int32 Version = 0; uint32 Cook = 0; uint32 Crc = 0;
+		Ar << FileMagic << Version << Cook << Crc;
+		if (FileMagic != Magic || Version != FormatVersion || Cook != CookVersion)
+		{
+			return false;
+		}
+		const int32 BodyOffset = static_cast<int32>(Ar.Tell());
+		if (FCrc::MemCrc32(Bytes.GetData() + BodyOffset, Bytes.Num() - BodyOffset) != Crc)
+		{
+			return false;
+		}
+		TSharedPtr<FBlob> Blob = MakeShared<FBlob>();
+		Serialize(Ar, *Blob);
+		if (Ar.IsError())
+		{
+			return false;
+		}
+		Out = Blob;
+		return true;
+	}
+
+	void Save(const FString& Path, uint16 CookVersion, FBlob& Blob)
+	{
+		TArray<uint8> Body;
+		{
+			FMemoryWriter BodyAr(Body);
+			Serialize(BodyAr, Blob);
+		}
+		TArray<uint8> File;
+		{
+			FMemoryWriter Ar(File);
+			uint32 FileMagic = Magic; int32 Version = FormatVersion; uint32 Cook = CookVersion;
+			uint32 Crc = FCrc::MemCrc32(Body.GetData(), Body.Num());
+			Ar << FileMagic << Version << Cook << Crc;
+			Ar.Serialize(Body.GetData(), Body.Num());
+		}
+		const FString Temp = Path + TEXT(".tmp") + FGuid::NewGuid().ToString(EGuidFormats::Digits);
+		if (FFileHelper::SaveArrayToFile(File, *Temp))
+		{
+			if (IFileManager::Get().Move(*Path, *Temp, true, true))
+			{
+				GWritten.Increment();
+			}
+			else
+			{
+				IFileManager::Get().Delete(*Temp);
+			}
+		}
+	}
+
+	IPhysXCooking* GetCooking(FName& OutFormat, FString& OutError)
+	{
+		IPhysXCookingModule* Module = GetPhysXCookingModule();
+		IPhysXCooking* Cooking = Module ? Module->GetPhysXCooking() : nullptr;
+		if (!Cooking || !Cooking->GetCooking())
+		{
+			OutError = TEXT("PhysX cooking interface is unavailable");
+			return nullptr;
+		}
+		OutFormat = FName(FPlatformProperties::GetPhysicsFormat());
+		TArray<FName> Supported;
+		Cooking->GetSupportedFormats(Supported);
+		if (!Supported.Contains(OutFormat))
+		{
+			OutError = TEXT("active PhysX cooking format is unsupported");
+			return nullptr;
+		}
+		return Cooking;
+	}
+
+	// Parse + cook a payload. Returns false when cooking is unavailable (nothing to cache).
+	bool Cook(const uint8* Bytes, int64 Size, IPhysXCooking* Cooking, FName Format, FBlob& Blob, FString& OutError)
+	{
+		FortniteLegacyChaos::FData Data;
+		FString ParseError;
+		if (!FortniteLegacyChaos::Read(Bytes, Size, Data, ParseError))
+		{
+			Blob.bOk = false;
+			Blob.Error = ParseError.IsEmpty() ? TEXT("unable to parse original Chaos payload") : ParseError;
+			return true;
+		}
+
+		Blob.Convexes.SetNum(Data.Convexes.Num());
+		for (int32 I = 0; I < Data.Convexes.Num(); ++I)
+		{
+			FConvexBlob& Out = Blob.Convexes[I];
+			const auto& Source = Data.Convexes[I];
+			if (!Source.IsValid() || !Source->bDoCollide) continue;
+			Out.bDoCollide = true;
+			// Stock UE accepts SucceededWithInflation (near-degenerate hulls); only a hard failure drops the hull.
+			Out.bNormalOk = Cooking->CookConvex(Format, EPhysXMeshCookFlags::Default, Source->Vertices, Out.Normal) != EPhysXCookingResult::Failed && Out.Normal.Num() > 0;
+			TArray<FVector> Mirrored = Source->Vertices;
+			for (FVector& V : Mirrored) V.X = -V.X;
+			Out.bMirroredOk = Cooking->CookConvex(Format, EPhysXMeshCookFlags::Default, Mirrored, Out.Mirrored) != EPhysXCookingResult::Failed && Out.Mirrored.Num() > 0;
+		}
+
+		for (const auto& Source : Data.TriangleMeshes)
+		{
+			if (!Source.IsValid()) continue; // original arrays can contain nulls
+			if (!Source->bDoCollide) { Blob.bOk = false; Blob.Error = TEXT("disabled cooked triangle mesh"); return true; }
+			const int32 NumTriangles = Source->Triangles.Num();
+			if (!NumTriangles || !Source->Vertices.Num()) { Blob.bOk = false; Blob.Error = TEXT("empty cooked triangle mesh"); return true; }
+			TArray<FTriIndices> Indices;
+			Indices.Reserve(NumTriangles);
+			for (const FIntVector& Index : Source->Triangles)
+			{
+				FTriIndices& Tri = Indices.AddDefaulted_GetRef();
+				Tri.v0 = Index.X; Tri.v1 = Index.Y; Tri.v2 = Index.Z;
+			}
+			FTriangleBlob& Out = Blob.Triangles.AddDefaulted_GetRef();
+			// Indices are already physics winding. The face remap table must be kept (never suppressed).
+			if (!Cooking->CookTriMesh(Format, EPhysXMeshCookFlags::Default, Source->Vertices, Indices, Source->MaterialIndices, false, Out.Cooked) || !Out.Cooked.Num())
+			{
+				Blob.bOk = false; Blob.Error = TEXT("triangle mesh cooking failed"); return true;
+			}
+			// Validate the cooked mesh once, here, and derive the per-face external map.
+			PxTriangleMesh* Mesh = nullptr;
+			{
+				FScopeLock Lock(&GPhysXCreateLock);
+				FPhysXInputStream Stream(Out.Cooked.GetData(), Out.Cooked.Num());
+				Mesh = GPhysXSDK ? GPhysXSDK->createTriangleMesh(Stream) : nullptr;
+			}
+			if (!Mesh || !Mesh->getNbTriangles()) { if (Mesh) Mesh->release(); Blob.bOk = false; Blob.Error = TEXT("cooked triangle mesh could not be created"); return true; }
+			const PxU32* Remap = Mesh->getTrianglesRemap();
+			FString Why;
+			if (!Remap || Mesh->getNbTriangles() > static_cast<PxU32>(NumTriangles))
+			{
+				Why = TEXT("triangle cook omitted or invalidated its face remap");
+			}
+			else
+			{
+				TBitArray<> Seen(false, NumTriangles);
+				Out.Faces.Reserve(Mesh->getNbTriangles());
+				for (PxU32 I = 0; I < Mesh->getNbTriangles() && Why.IsEmpty(); ++I)
+				{
+					const PxU32 Input = Remap[I];
+					if (Input >= static_cast<PxU32>(NumTriangles) || Seen[Input])
+					{
+						Why = TEXT("triangle cook returned an invalid or repeated input face");
+					}
+					else if (Source->MaterialIndices.Num() && Mesh->getTriangleMaterialIndex(I) != Source->MaterialIndices[Input])
+					{
+						Why = TEXT("triangle cook changed material correspondence");
+					}
+					else
+					{
+						Seen[Input] = true;
+						Out.Faces.Add(Source->ExternalFaceIndexMap.Num() ? Source->ExternalFaceIndexMap[Input] : INDEX_NONE);
+					}
+				}
+			}
+			{
+				FScopeLock Lock(&GPhysXCreateLock);
+				Mesh->release();
+			}
+			if (!Why.IsEmpty()) { Blob.bOk = false; Blob.Error = Why; return true; }
+		}
+
+		Blob.UVIndices = MoveTemp(Data.UVIndices);
+		Blob.UVPositions = MoveTemp(Data.UVPositions);
+		Blob.UVChannels = MoveTemp(Data.UVChannels);
+		Blob.FaceRemap = MoveTemp(Data.FaceRemap);
+		Blob.bOk = true;
+		return true;
+	}
+}
+
+bool Acquire(const uint8* Bytes, int64 Size, TSharedPtr<const FBlob>& OutBlob, FString& OutError)
+{
+	FName Format;
+	IPhysXCooking* Cooking = GetCooking(Format, OutError);
+	const uint16 CookVersion = Cooking ? Cooking->GetVersion(Format) : 0;
+
+	const bool bUseCache = !IsDisabled() && Cooking;
+	FString Path;
+	if (bUseCache)
+	{
+		Path = PathFor(KeyFor(Bytes, Size));
+		const double Start = FPlatformTime::Seconds();
+		TSharedPtr<FBlob> Loaded;
+		if (TryLoad(Path, CookVersion, Loaded))
+		{
+			GLoadMicros.Add(static_cast<int64>((FPlatformTime::Seconds() - Start) * 1e6));
+			GHits.Increment();
+			if (!Loaded->bOk) GNegative.Increment();
+			OutBlob = Loaded;
+			return true;
+		}
+	}
+	if (!Cooking)
+	{
+		return false;
+	}
+
+	const double Start = FPlatformTime::Seconds();
+	TSharedPtr<FBlob> Blob = MakeShared<FBlob>();
+	if (!Cook(Bytes, Size, Cooking, Format, *Blob, OutError))
+	{
+		return false;
+	}
+	GCookMicros.Add(static_cast<int64>((FPlatformTime::Seconds() - Start) * 1e6));
+	GMisses.Increment();
+	if (!Blob->bOk) GCookFailed.Increment();
+	if (bUseCache)
+	{
+		Save(Path, CookVersion, *Blob);
+	}
+	OutBlob = Blob;
+	return true;
+}
+
+void LogStats(const TCHAR* Context)
+{
+	UE_LOG(LogFortniteCollisionCache, Display, TEXT("FortniteCollisionCache[%s]: hits=%d (negative=%d, load %.2fs) misses=%d (cook %.2fs, unusable=%d) written=%d dir=%s"),
+		Context, GHits.GetValue(), GNegative.GetValue(), GLoadMicros.GetValue() / 1e6, GMisses.GetValue(), GCookMicros.GetValue() / 1e6,
+		GCookFailed.GetValue(), GWritten.GetValue(), *CacheDir());
+}
+
+void BakeContent(const FString& ContentDir)
+{
+	const double Start = FPlatformTime::Seconds();
+	TArray<FString> Files;
+	IFileManager::Get().FindFilesRecursive(Files, *ContentDir, TEXT("*.uexp"), true, false);
+	UE_LOG(LogFortniteCollisionCache, Display, TEXT("FortniteCollisionCache: baking %d .uexp files under %s into %s"), Files.Num(), *ContentDir, *CacheDir());
+
+	FThreadSafeCounter Payloads, Scanned, Failed;
+	ParallelFor(Files.Num(), [&](int32 Index)
+	{
+		const FString& File = Files[Index];
+		const int64 FileSize = IFileManager::Get().FileSize(*File);
+		if (FileSize < 64 || FileSize > (1LL << 30)) return;
+		// Header size of the companion .uasset/.umap: original bulk offsets are relative to the combined package.
+		int64 HeaderSize = IFileManager::Get().FileSize(*FPaths::ChangeExtension(File, TEXT("uasset")));
+		if (HeaderSize < 0) HeaderSize = IFileManager::Get().FileSize(*FPaths::ChangeExtension(File, TEXT("umap")));
+		if (HeaderSize < 0) return;
+		TArray<uint8> Bytes;
+		if (!FFileHelper::LoadFileToArray(Bytes, *File, FILEREAD_Silent)) return;
+		Scanned.Increment();
+		const int64 N = Bytes.Num();
+		for (int64 H = 0; H + 24 <= N; ++H)
+		{
+			if (Bytes[H] != 0x48 || Bytes[H + 1] || Bytes[H + 2] || Bytes[H + 3]) continue;
+			uint32 Count0, Count1; int64 Offset;
+			FMemory::Memcpy(&Count0, &Bytes[H + 4], 4);
+			FMemory::Memcpy(&Count1, &Bytes[H + 8], 4);
+			FMemory::Memcpy(&Offset, &Bytes[H + 12], 8);
+			if (Count0 != Count1 || Count0 < 32 || H + 20 + static_cast<int64>(Count0) > N || Offset != HeaderSize + H + 20) continue;
+			if (Bytes[H + 20] != 4 || Bytes[H + 21] || Bytes[H + 22] || Bytes[H + 23]) continue;
+			TSharedPtr<const FBlob> Blob; FString Error;
+			// Parse failures of false-positive signatures must not be cached, so check parse first only via Acquire's own
+			// result: Acquire caches negatives, which is harmless (keyed by exact bytes) and avoids re-parsing at load.
+			if (Acquire(&Bytes[H + 20], Count0, Blob, Error))
+			{
+				Payloads.Increment();
+				if (Blob.IsValid() && !Blob->bOk) Failed.Increment();
+			}
+			H += 20 + Count0 - 1;
+		}
+	}, EParallelForFlags::None);
+
+	UE_LOG(LogFortniteCollisionCache, Display, TEXT("FortniteCollisionCache: bake scanned %d files, %d payloads (%d unusable) in %.1fs"),
+		Scanned.GetValue(), Payloads.GetValue(), Failed.GetValue(), FPlatformTime::Seconds() - Start);
+	LogStats(TEXT("bake"));
+}
+
+// -FortniteBakeCollision: bake all staged collision payloads in parallel right after engine init, then exit.
+static FDelayedAutoRegisterHelper GBakeOnStartup(EDelayedRegisterRunPhase::EndOfEngineInit, []()
+{
+	if (!FParse::Param(FCommandLine::Get(), TEXT("FortniteBakeCollision")))
+	{
+		return;
+	}
+	FString Dir;
+	if (!FParse::Value(FCommandLine::Get(), TEXT("-FortniteBakeCollisionDir="), Dir) || Dir.IsEmpty())
+	{
+		Dir = FPaths::ProjectContentDir();
+	}
+	BakeContent(FPaths::ConvertRelativePathToFull(Dir));
+	FPlatformMisc::RequestExitWithStatus(false, 0);
+});
+}
