+#pragma once
+#include "CoreMinimal.h"
+
+// Original Fortnite 12.60 buffer archive: float precision 4, ExternalPhysics 37,
+// Destruction 10. These versions belong to the fresh archive, not the package.
+// No coordinate conversion is applied. Geometry remains in body space.
+namespace FortniteLegacyChaos
+{
+struct FConvex { TArray<FVector> Vertices; bool bDoCollide = true; };
+struct FTriangleMesh
+{
+    TArray<FVector> Vertices;
+    TArray<FIntVector> Triangles;
+    TArray<uint16> MaterialIndices;
+    TArray<int32> ExternalFaceIndexMap;
+    bool bDoCollide = true;
+};
+struct FData
+{
+    TArray<TSharedPtr<FConvex>> Convexes;
+    TArray<TSharedPtr<FTriangleMesh>> TriangleMeshes;
+    TArray<int32> UVIndices;
+    TArray<FVector> UVPositions;
+    TArray<TArray<FVector2D>> UVChannels;
+    TArray<int32> FaceRemap;
+};
+namespace Private
+{
+class FReader
+{
+    const uint8* Bytes;
+    int64 Size, Offset = 0, Allocated = 0;
+    FString& Error;
+    // Explicit resource limits, independent of the untrusted wire counts.
+    static constexpr int32 MaxCount = 1024 * 1024;
+    static constexpr int64 MaxAllocation = 256LL * 1024 * 1024;
+    struct FEntry { uint8 Type = 0; TSharedPtr<FConvex> Convex; TSharedPtr<FTriangleMesh> Mesh; };
+    TMap<int32, FEntry> Objects;
+    struct FNode { int32 A, B; bool Leaf; bool EmptyA, EmptyB; };
+    bool Fail(const TCHAR* Why)
+    {
+        if (Error.IsEmpty()) Error = FString::Printf(TEXT("Original Chaos at byte %lld: %s"), (long long)Offset, Why);
+        return false;
+    }
+    bool Need(int64 N) { return N >= 0 && N <= Size - Offset ? true : Fail(TEXT("truncated payload")); }
+    bool Budget(int64 N)
+    {
+        if (N < 0 || N > MaxAllocation - Allocated) return Fail(TEXT("allocation budget exceeded"));
+        Allocated += N; return true;
+    }
+    bool U8(uint8& V) { if (!Need(1)) return false; V = Bytes[Offset++]; return true; }
+    bool U16(uint16& V)
+    {
+        if (!Need(2)) return false;
+        V = uint16(Bytes[Offset]) | (uint16(Bytes[Offset+1]) << 8); Offset += 2; return true;
+    }
+    bool U32(uint32& V)
+    {
+        if (!Need(4)) return false;
+        V = uint32(Bytes[Offset]) | (uint32(Bytes[Offset+1]) << 8) |
+            (uint32(Bytes[Offset+2]) << 16) | (uint32(Bytes[Offset+3]) << 24);
+        Offset += 4; return true;
+    }
+    bool I32(int32& V) { uint32 U; if (!U32(U)) return false; FMemory::Memcpy(&V, &U, 4); return true; }
+    bool Float(float& V)
+    {
+        uint32 U; if (!U32(U)) return false; FMemory::Memcpy(&V, &U, 4);
+        return FMath::IsFinite(V) ? true : Fail(TEXT("nonfinite float"));
+    }
+    bool Bool(bool& V)
+    {
+        uint32 U; if (!U32(U)) return false;
+        if (U > 1) return Fail(TEXT("invalid uint32 boolean"));
+        V = U != 0; return true;
+    }
+    bool Count(int32& N, int64 WireStride, int64 MemoryStride = 0)
+    {
+        if (!I32(N)) return false;
+        if (N < 0 || N > MaxCount) return Fail(TEXT("array count exceeds bounds"));
+        if (WireStride <= 0 || N > (Size - Offset) / WireStride) return Fail(TEXT("array exceeds remaining payload"));
+        return Budget(int64(N) * MemoryStride);
+    }
+    bool Vec(FVector& V)
+    {
+        float X,Y,Z; if (!Float(X) || !Float(Y) || !Float(Z)) return false; V = FVector(X,Y,Z); return true;
+    }
+    bool Bounds(bool* Empty = nullptr)
+    {
+        FVector Min,Max; if (!Vec(Min) || !Vec(Max)) return false;
+        // Chaos TAABB's default/empty state is (+FLT_MAX, -FLT_MAX).
+        const float Limit = 3.4028234663852886e38f;
+        const bool IsEmpty = Min.X == Limit && Min.Y == Limit && Min.Z == Limit &&
+            Max.X == -Limit && Max.Y == -Limit && Max.Z == -Limit;
+        if (Empty) *Empty = IsEmpty;
+        return (Empty && IsEmpty) || (Min.X <= Max.X && Min.Y <= Max.Y && Min.Z <= Max.Z)
+            ? true : Fail(TEXT("inverted bounds"));
+    }
+    bool Vectors(TArray<FVector>& A)
+    {
+        int32 N; if (!Count(N,12,sizeof(FVector))) return false; A.SetNum(N);
+        for (FVector& V : A) if (!Vec(V)) return false;
+        return true;
+    }
+    bool Ints(TArray<int32>& A)
+    {
+        int32 N; if (!Count(N,4,sizeof(int32))) return false; A.SetNum(N);
+        for (int32& V : A) if (!I32(V)) return false;
+        return true;
+    }
+    bool Particles(TArray<FVector>& A) { bool View; return Bool(View) && Vectors(A); }
+    bool Flags() { bool Convex, StoredCollide; return Bool(Convex) && Bool(StoredCollide); }
+    bool ConvexBody(FConvex& C)
+    {
+        if (!Flags()) return false;
+        int32 N; if (!Count(N,24)) return false;
+        for (int32 I=0; I<N; ++I)
+        {
+            FVector Origin, Normal;
+            if (!Vec(Origin) || !Vec(Normal)) return false;
+            if (Normal.X == 0 && Normal.Y == 0 && Normal.Z == 0) return Fail(TEXT("zero convex plane normal"));
+        }
+        float Volume; FVector Center;
+        if (!Particles(C.Vertices) || !Bounds() || !Float(Volume) || !Vec(Center)) return false;
+        if (N < 4 || Volume < 0 || C.Vertices.Num() < 4) return Fail(TEXT("invalid convex geometry"));
+        C.bDoCollide = true; // 1437feff0: Destruction < 11 overrides the stored value.
+        return true;
+    }
+    bool Payloads(int32 Triangles, int32* OutCount = nullptr)
+    {
+        int32 N; if (!Count(N,28)) return false; if (OutCount) *OutCount=N;
+        for (int32 I=0; I<N; ++I)
+        {
+            int32 P; if (!I32(P) || !Bounds()) return false;
+            if (P < 0 || P >= Triangles) return Fail(TEXT("BVH payload index out of range"));
+        }
+        return true;
+    }
+    bool Tree(int32 Triangles)
+    {
+        bool EmptyTreeBounds; if (!Bounds(&EmptyTreeBounds)) return false;
+        int32 N; if (!Count(N,60,sizeof(FNode))) return false;
+        TArray<FNode> Nodes; Nodes.SetNum(N);
+        for (FNode& Node : Nodes)
+            if (!Bounds(&Node.EmptyA) || !Bounds(&Node.EmptyB) || !I32(Node.A) || !I32(Node.B) || !Bool(Node.Leaf)) return false;
+        int32 Leaves; if (!Count(Leaves,4)) return false;
+        for (int32 I=0; I<Leaves; ++I) if (!Payloads(Triangles)) return false;
+        for (const FNode& Node : Nodes)
+        {
+            if (!Node.Leaf && (Node.EmptyA || Node.EmptyB)) return Fail(TEXT("empty internal BVH child bounds"));
+            const int32 Limit = Node.Leaf ? Leaves : N;
+            if (Node.A < -1 || Node.A >= Limit || Node.B < -1 || Node.B >= Limit)
+                return Fail(TEXT("BVH child index out of range"));
+        }
+        int32 Dirty,Global;
+        if (!Payloads(Triangles,&Dirty) || !Payloads(Triangles,&Global)) return false;
+        bool HasMap; if (!Bool(HasMap)) return false;
+        if (HasMap)
+        {
+            // 1437fc6d0 serializes all keys first, then three ints per key.
+            int32 K; if (!Count(K,16,64)) return false;
+            TSet<int32> Keys;
+            for (int32 I=0; I<K; ++I)
+            {
+                int32 Key; if (!I32(Key)) return false;
+                if (Key < 0 || Key >= Triangles || Keys.Contains(Key)) return Fail(TEXT("invalid BVH map key"));
+                Keys.Add(Key);
+            }
+            for (int32 I=0; I<K; ++I)
+            {
+                int32 G,D,L; if (!I32(G) || !I32(D) || !I32(L)) return false;
+                if (G < -1 || G >= Global || D < -1 || D >= Dirty || L < -1 || L >= Leaves)
+                    return Fail(TEXT("BVH payload info index out of range"));
+            }
+        }
+        int32 Children,Depth; float MaxBounds;
+        if (!I32(Children) || !I32(Depth) || !Float(MaxBounds)) return false;
+        return Children >= 0 && Depth >= 0 && MaxBounds >= 0 ? true : Fail(TEXT("invalid BVH settings"));
+    }
+    bool MeshBody(FTriangleMesh& M)
+    {
+        if (!Flags() || !Particles(M.Vertices)) return false;
+        bool Large; int32 N;
+        if (!Bool(Large) || !Count(N,Large ? 12 : 6,sizeof(FIntVector))) return false;
+        M.Triangles.SetNum(N);
+        for (FIntVector& T : M.Triangles)
+        {
+            if (Large) { if (!I32(T.X) || !I32(T.Y) || !I32(T.Z)) return false; }
+            else { uint16 A,B,C; if (!U16(A) || !U16(B) || !U16(C)) return false; T = FIntVector(A,B,C); }
+            if (T.X < 0 || T.Y < 0 || T.Z < 0 || T.X >= M.Vertices.Num() || T.Y >= M.Vertices.Num() || T.Z >= M.Vertices.Num())
+                return Fail(TEXT("triangle vertex index out of range"));
+        }
+        if (!Bounds() || !Tree(M.Triangles.Num()) || !Count(N,2,sizeof(uint16))) return false;
+        M.MaterialIndices.SetNum(N);
+        for (uint16& V : M.MaterialIndices) if (!U16(V)) return false;
+        if (!Ints(M.ExternalFaceIndexMap)) return false;
+        if ((N != 0 && N != M.Triangles.Num()) ||
+            (M.ExternalFaceIndexMap.Num() != 0 && M.ExternalFaceIndexMap.Num() != M.Triangles.Num()))
+            return Fail(TEXT("triangle material/face map cardinality mismatch"));
+        for (int32 I : M.ExternalFaceIndexMap) if (I < -1) return Fail(TEXT("invalid external face index"));
+        M.bDoCollide = true;
+        return true;
+    }
+    bool Pointer(uint8 Expected, FEntry& Out)
+    {
+        bool Present; if (!Bool(Present)) return false;
+        if (!Present) { Out = FEntry(); return true; }
+        int32 Id; if (!I32(Id)) return false;
+        if (Id < 0 || Id >= MaxCount) return Fail(TEXT("object identity exceeds bounds"));
+        if (const FEntry* Existing = Objects.Find(Id))
+        {
+            if (Existing->Type != Expected) return Fail(TEXT("object reference has incompatible type"));
+            Out = *Existing; return true;
+        }
+        uint8 Type; if (!U8(Type)) return false;
+        if (Type != 8 && Type != 11) return Fail(TEXT("unsupported implicit type (only plain convex 8 and triangle 11 supported)"));
+        if (Type != Expected) return Fail(TEXT("object type incompatible with containing array"));
+        if (!Budget(256)) return false;
+        Out.Type=Type;
+        if (Type == 8)
+        {
+            Out.Convex = MakeShared<FConvex>();
+            if (!ConvexBody(*Out.Convex)) return false;
+        }
+        else
+        {
+            Out.Mesh = MakeShared<FTriangleMesh>();
+            if (!MeshBody(*Out.Mesh)) return false;
+        }
+        Objects.Add(Id,Out); return true;
+    }
+public:
+    FReader(const uint8* In, int64 InSize, FString& InError) : Bytes(In), Size(InSize), Error(InError) {}
+    bool Parse(FData& Out)
+    {
+        if (!Bytes || Size < 4 || Size > 512LL * 1024 * 1024) return Fail(TEXT("invalid input buffer or payload size limit"));
+        int32 Precision,N; if (!I32(Precision)) return false;
+        if (Precision != 4) return Fail(TEXT("unsupported scalar precision"));
+        if (!Count(N,4,sizeof(TSharedPtr<FConvex>))) return false;
+        Out.Convexes.SetNum(N);
+        for (auto& C : Out.Convexes) { FEntry E; if (!Pointer(8,E)) return false; C=E.Convex; }
+        if (!Count(N,4,sizeof(TSharedPtr<FTriangleMesh>))) return false;
+        Out.TriangleMeshes.SetNum(N);
+        for (auto& M : Out.TriangleMeshes) { FEntry E; if (!Pointer(11,E)) return false; M=E.Mesh; }
+        if (!Ints(Out.UVIndices) || !Vectors(Out.UVPositions)) return false;
+        if (!Count(N,4,sizeof(TArray<FVector2D>))) return false;
+        Out.UVChannels.SetNum(N);
+        // 144444eb0 -> 141540b90 -> 140e1ff50: nested count + float2 pairs.
+        for (auto& Channel : Out.UVChannels)
+        {
+            int32 NumUV; if (!Count(NumUV,8,sizeof(FVector2D))) return false;
+            Channel.SetNum(NumUV);
+            for (FVector2D& V : Channel)
+            { float X,Y; if (!Float(X) || !Float(Y)) return false; V=FVector2D(X,Y); }
+            if (NumUV != Out.UVPositions.Num()) return Fail(TEXT("UV channel/position cardinality mismatch"));
+        }
+        for (int32 I : Out.UVIndices) if (I < 0 || I >= Out.UVPositions.Num()) return Fail(TEXT("UV position index out of range"));
+        if (Out.UVIndices.Num() % 3 != 0) return Fail(TEXT("UV index count is not triangular"));
+        if (!Ints(Out.FaceRemap)) return false;
+        for (int32 I : Out.FaceRemap) if (I < -1) return Fail(TEXT("invalid face remap index"));
+        return Offset == Size ? true : Fail(TEXT("trailing payload bytes"));
+    }
+};
+}
+inline bool Read(const uint8* Data, int64 Size, FData& Out, FString& Error)
+{
+    Error.Empty();
+    FData Candidate;
+    Private::FReader Reader(Data,Size,Error);
+    if (!Reader.Parse(Candidate)) return false;
+    Out=MoveTemp(Candidate);
+    return true;
+}
+}
