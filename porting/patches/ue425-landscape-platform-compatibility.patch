+// Original 12.60 implementation: 0x143accef0. This is a loading-only
+// compatibility path; UE 4.25 authoring and DDC retain their existing format.
+void FLandscapeComponentDerivedData::SerializeLegacyCookedData(FArchive& Ar, UObject* Owner)
+{
+	check(Ar.IsLoading());
+	Ar << CompressedLandscapeData;
+	int32 NumStreamingLODs = 0;
+	Ar << NumStreamingLODs;
+	if (Ar.IsError() || NumStreamingLODs < 0)
+	{
+		Ar.SetError();
+		return;
+	}
+	StreamingLODDataArray.Empty(NumStreamingLODs);
+	StreamingLODDataArray.AddDefaulted(NumStreamingLODs);
+	CachedLODDataFileName.Empty();
+	for (int32 Idx = 0; Idx < NumStreamingLODs; ++Idx)
+	{
+#if !WITH_EDITORONLY_DATA && USE_BULKDATA_STREAMING_TOKEN
+		FByteBulkData LODData;
+		LODData.Serialize(Ar, Owner, Idx);
+		StreamingLODDataArray[Idx] = LODData.CreateStreamingToken();
+#else
+		FByteBulkData& LODData = StreamingLODDataArray[Idx];
+		LODData.Serialize(Ar, Owner, Idx);
+#endif
+		if (Ar.IsError())
+		{
+			return;
+		}
+		if (CachedLODDataFileName.IsEmpty() &&
+			(LODData.GetBulkDataFlags() & BULKDATA_Force_NOT_InlinePayload))
+		{
+			CachedLODDataFileName = LODData.GetFilename();
+		}
+	}
+}
