@@ -0,0 +1,303 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+#include "Streaming/LandscapeMeshMobileUpdate.h"
+#include "LandscapeComponent.h"
+#include "LandscapeRenderMobile.h"
+#include "RHICommandList.h"
+#include "Streaming/RenderAssetUpdate.inl"
+
+template class TRenderAssetUpdate<FLandscapeMeshMobileUpdateContext>;
+
+FLandscapeMeshMobileUpdateContext::FLandscapeMeshMobileUpdateContext(ULandscapeLODStreamingProxy* Proxy, EThreadType Thread)
+    : LandscapeProxy(Proxy), RenderData(Proxy ? Proxy->GetRenderData().Get() : nullptr), CurrentThread(Thread)
+{
+    check(Proxy);
+    checkSlow(Thread != FRenderAssetUpdate::TT_Render || IsInRenderingThread());
+}
+FLandscapeMeshMobileUpdateContext::FLandscapeMeshMobileUpdateContext(UStreamableRenderAsset* Proxy, EThreadType Thread)
+    : FLandscapeMeshMobileUpdateContext(CastChecked<ULandscapeLODStreamingProxy>(Proxy), Thread) {}
+UStreamableRenderAsset* FLandscapeMeshMobileUpdateContext::GetRenderAsset() const { return LandscapeProxy; }
+
+FLandscapeMeshMobileUpdate::FLandscapeMeshMobileUpdate(
+    ULandscapeLODStreamingProxy* Proxy, int32 RequestedMips)
+    : TRenderAssetUpdate<FLandscapeMeshMobileUpdateContext>(Proxy, RequestedMips)
+{
+    TSharedPtr<FLandscapeMobileRenderData, ESPMode::ThreadSafe> RenderData = Proxy->GetRenderData();
+    if (!RenderData.IsValid())
+    {
+        PendingFirstMip = INDEX_NONE;
+        this->RequestedMips = INDEX_NONE;
+        bIsCancelled = true;
+        CurrentFirstLODIdx = INDEX_NONE;
+    }
+    else
+    {
+        CurrentFirstLODIdx = RenderData->CurrentFirstLODIdx;
+    }
+}
+
+// Original 0x1445d5620. PushTask is inlined in the capture: thread 1,
+// callback bound to this, cancellation thread 0, null cancellation callback.
+FLandscapeMeshMobileStreamOut::FLandscapeMeshMobileStreamOut(
+    ULandscapeLODStreamingProxy* Proxy, int32 RequestedMips)
+    : FLandscapeMeshMobileUpdate(Proxy, RequestedMips)
+{
+    PushTask(FContext(Proxy, TT_None), TT_Render,
+        SRA_UPDATE_CALLBACK(ShrinkResources), TT_None, nullptr);
+}
+
+// Original 0x1445f4db0. The proxy accessors preserve direct cached-byte
+// reads and writes in editor builds as well.
+void FLandscapeMeshMobileStreamOut::ShrinkResources(const FContext& Context)
+{
+    ULandscapeLODStreamingProxy* Proxy = const_cast<ULandscapeLODStreamingProxy*>(Context.LandscapeProxy);
+    FLandscapeMobileRenderData* RenderData = Context.RenderData;
+    if (!IsCancelled() && Proxy && RenderData)
+    {
+        const uint8 OldResidentLODs = Proxy->GetResidentLODsFromStreaming();
+        RenderData->CurrentFirstLODIdx = static_cast<uint8>(PendingFirstMip);
+        const uint8 NewResidentLODs = static_cast<uint8>(Proxy->GetNumMipsForStreaming() - PendingFirstMip);
+        Proxy->SetResidentLODsFromStreaming(NewResidentLODs);
+
+        const int32 OldSize = Proxy->CalcCumulativeLODSize(OldResidentLODs);
+        const int32 NewSizeWithoutInline = Proxy->CalcCumulativeLODSize(NewResidentLODs);
+        const int32 SizeDelta = NewSizeWithoutInline - OldSize;
+        if (SizeDelta != 0)
+        {
+            FLandscapeVertexBufferMobile::UpdateMemoryStat(SizeDelta);
+            FRHIVertexBuffer* OldBuffer = RenderData->VertexBuffer->VertexBufferRHI;
+            const int32 NewSize = static_cast<int32>(OldBuffer->GetSize()) + SizeDelta;
+            FRHIResourceCreateInfo CreateInfo;
+            FVertexBufferRHIRef NewBuffer = RHICreateVertexBuffer(NewSize, BUF_Static, CreateInfo);
+            FRHICommandListExecutor::GetImmediateCommandList().CopyBufferRegion(NewBuffer, 0, OldBuffer, 0, NewSize);
+            TRHIResourceUpdateBatcher<1> Batcher;
+            Batcher.QueueUpdateRequest(OldBuffer, NewBuffer);
+        }
+    }
+}
+
+FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::FLandscapeMeshMobileStreamIn_IO_AsyncReallocate(
+    ULandscapeLODStreamingProxy* Proxy, int32 RequestedMips, bool bHighPrio)
+    : FLandscapeMeshMobileUpdate(Proxy, RequestedMips)
+    , IntermediateVertexBuffer(nullptr)
+    , bHighPrioIORequest(bHighPrio)
+{
+    FMemory::Memzero(StagingLODDataArray, sizeof(StagingLODDataArray));
+    FMemory::Memzero(StagingLODDataSizes, sizeof(StagingLODDataSizes));
+    FMemory::Memzero(IORequests, sizeof(IORequests));
+    PushTask(FContext(Proxy, TT_None), TT_Async,
+        SRA_UPDATE_CALLBACK(DoInitiateIO), TT_None, nullptr);
+}
+
+// Original 0x1445e56c0. Inline GetIOFilename and SetIORequest from the
+// analogous UE 4.26 flow; the original ignores the filename helper's result.
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoInitiateIO(const FContext& Context)
+{
+    FString IOFilename;
+    const ULandscapeLODStreamingProxy* Proxy = Context.LandscapeProxy;
+    if (!IsCancelled() && Proxy)
+    {
+        Proxy->GetMipDataFilename(PendingFirstMip, IOFilename); // 0x143aca8e0
+        if (!IsCancelled())
+        {
+            if (Proxy)
+            {
+                // 0x1445dfaa0 -> 0x1445da5b0. Context is captured even
+                // though the recovered callback uses only this and cancellation.
+                AsyncFileCallback = [this, Context](bool bWasCancelled, IBulkDataIORequest* Request)
+                {
+                    TaskSynchronization.Decrement();
+                    if (bWasCancelled) { MarkAsCancelled(); }
+                    Tick(TT_None);
+                };
+                for (int32 Index = PendingFirstMip; Index < CurrentFirstLODIdx; ++Index)
+                {
+                    auto& BulkData = Proxy->GetStreamingLODBulkData(Index);
+                    if (BulkData.GetBulkDataSize() != 0)
+                    {
+                        // The recovered path does not handle a null request. A failed
+                        // submission can therefore leave synchronization outstanding.
+                        TaskSynchronization.Increment();
+#if !WITH_EDITORONLY_DATA && USE_BULKDATA_STREAMING_TOKEN
+                        FUntypedBulkData::BulkDataRangeArray BulkDataArray;
+                        BulkDataArray.Add(&BulkData);
+                        IORequests[Index] = FUntypedBulkData::CreateStreamingRequestForRange(
+                            IOFilename, BulkDataArray, bHighPrioIORequest ? AIOP_BelowNormal : AIOP_Low,
+                            &AsyncFileCallback);
+#else
+                        IORequests[Index] = BulkData.CreateStreamingRequest(
+                            bHighPrioIORequest ? AIOP_BelowNormal : AIOP_Low, &AsyncFileCallback, nullptr);
+#endif
+                    }
+                }
+            }
+            else
+            {
+                MarkAsCancelled();
+            }
+        }
+    }
+    else
+    {
+        MarkAsCancelled();
+    }
+    PushTask(Context, TT_Async, SRA_UPDATE_CALLBACK(DoGetIORequestResults),
+        TT_Async, SRA_UPDATE_CALLBACK(DoCancelIO));
+}
+
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoGetIORequestResults(const FContext& Context)
+{
+    if (!IsCancelled() && Context.LandscapeProxy && Context.RenderData)
+    {
+        for (int32 Index = PendingFirstMip; Index < CurrentFirstLODIdx; ++Index)
+        {
+            IBulkDataIORequest* Request = IORequests[Index];
+            if (Request)
+            {
+                IORequests[Index] = nullptr;
+                while (!Request->PollCompletion())
+                {
+                    FPlatformProcess::Sleep(0.000001f);
+                }
+                StagingLODDataArray[Index] = Request->GetReadResults();
+                StagingLODDataSizes[Index] = Request->GetSize();
+                delete Request;
+            }
+        }
+    }
+    ClearIORequest(Context); // 0x1445e0c50
+    PushTask(Context, TT_Render, SRA_UPDATE_CALLBACK(DoExpandResources),
+        Context.GetCurrentThread(), SRA_UPDATE_CALLBACK(DoCancel));
+}
+
+// Original 0x1445da650, reached by closure 0x1445dfab0. The capture's
+// first argument is closure storage containing this, not this directly.
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoCancelIO(const FContext& Context)
+{
+    ClearIORequest(Context); // 0x1445e0c50
+    PushTask(Context, TT_None, nullptr,
+        Context.GetCurrentThread(), SRA_UPDATE_CALLBACK(DoCancel));
+}
+
+// Original 0x1445e0c50. Context is unused in the binary; the parameter
+// keeps the signature consistent with the corresponding 4.26 helper.
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::ClearIORequest(const FContext& Context)
+{
+    for (int32 Index = PendingFirstMip; Index < CurrentFirstLODIdx; ++Index)
+    {
+        IBulkDataIORequest*& Request = IORequests[Index];
+        if (Request)
+        {
+            if (!Request->PollCompletion())
+            {
+                Request->Cancel();
+                Request->WaitCompletion(0.0f);
+            }
+            delete Request;
+            Request = nullptr;
+        }
+    }
+}
+
+// Original 0x1445d99b0, reached by closure 0x1445df9a0.
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoExpandResources(const FContext& Context)
+{
+    ExpandResources(Context); // 0x1445e8fe0
+    PushTask(Context, TT_Render, SRA_UPDATE_CALLBACK(DoFinishUpdate),
+        Context.GetCurrentThread(), SRA_UPDATE_CALLBACK(DoCancel));
+}
+
+// Original 0x1445e35e0, reached by closure 0x1445df910. Free is inferred
+// from the UE analogue and the allocator callee 0x142bee710.
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoCancel(const FContext& Context)
+{
+    for (int32 Index = 0; Index < 8; ++Index)
+    {
+        FMemory::Free(StagingLODDataArray[Index]);
+        StagingLODDataArray[Index] = nullptr;
+        StagingLODDataSizes[Index] = 0;
+    }
+    DoFinishUpdate(Context); // 0x1445e44a0
+}
+
+// Original 0x1445e8fe0. Buffer creation, lock, unlock and queued copy are
+// expressed using the 4.25/4.26 RHI API corresponding to captured RHI calls.
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::ExpandResources(const FContext& Context)
+{
+    FLandscapeMobileRenderData* RenderData = Context.RenderData;
+    if (!IsCancelled() && Context.LandscapeProxy && RenderData)
+    {
+        const uint32 OldSize = RenderData->VertexBuffer->VertexBufferRHI->GetSize();
+        uint32 NewSize = OldSize;
+        for (int32 Index = CurrentFirstLODIdx - 1; Index >= PendingFirstMip; --Index)
+        {
+            NewSize += StagingLODDataSizes[Index];
+        }
+        if (NewSize != OldSize)
+        {
+            FRHIResourceCreateInfo CreateInfo;
+            IntermediateVertexBuffer = RHICreateVertexBuffer(NewSize, BUF_Static, CreateInfo);
+            uint8* Dest = static_cast<uint8*>(RHILockVertexBuffer(IntermediateVertexBuffer, OldSize, NewSize - OldSize, RLM_WriteOnly));
+            for (int32 Index = CurrentFirstLODIdx - 1; Index >= PendingFirstMip; --Index)
+            {
+                if (StagingLODDataSizes[Index] > 0)
+                {
+                    FMemory::Memcpy(Dest, StagingLODDataArray[Index], StagingLODDataSizes[Index]);
+                    Dest += StagingLODDataSizes[Index];
+                    FMemory::Free(StagingLODDataArray[Index]);
+                    StagingLODDataArray[Index] = nullptr;
+                    StagingLODDataSizes[Index] = 0;
+                }
+            }
+            RHIUnlockVertexBuffer(IntermediateVertexBuffer);
+            FRHICommandListExecutor::GetImmediateCommandList().CopyBufferRegion(
+                IntermediateVertexBuffer, 0, RenderData->VertexBuffer->VertexBufferRHI, 0, OldSize);
+        }
+    }
+}
+
+// Original 0x1445e44a0, reached by closure 0x1445dfb40 and DoCancel.
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoFinishUpdate(const FContext& Context)
+{
+    ULandscapeLODStreamingProxy* Proxy = const_cast<ULandscapeLODStreamingProxy*>(Context.LandscapeProxy);
+    FLandscapeMobileRenderData* RenderData = Context.RenderData;
+    if (!IsCancelled() && Proxy && RenderData)
+    {
+        if (IntermediateVertexBuffer)
+        {
+            FLandscapeVertexBufferMobile* VertexBuffer = RenderData->VertexBuffer;
+            FLandscapeVertexBufferMobile::UpdateMemoryStat(IntermediateVertexBuffer->GetSize() - VertexBuffer->VertexBufferRHI->GetSize());
+            TRHIResourceUpdateBatcher<1> Batcher;
+            Batcher.QueueUpdateRequest(VertexBuffer->VertexBufferRHI, IntermediateVertexBuffer);
+        }
+        RenderData->CurrentFirstLODIdx = static_cast<uint8>(PendingFirstMip);
+        Proxy->SetResidentLODsFromStreaming(static_cast<uint8>(Proxy->GetNumMipsForStreaming() - PendingFirstMip));
+    }
+    IntermediateVertexBuffer.SafeRelease();
+}
+
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::Abort()
+{
+    if (!IsCancelled() && !IsCompleted())
+    {
+        FLandscapeMeshMobileUpdate::Abort();
+        for (int32 Index = 0; Index < 8; ++Index)
+        {
+            if (IORequests[Index])
+            {
+                (new FAutoDeleteAsyncTask<FCancelIORequestsTask>(this))->StartBackgroundTask();
+                return;
+            }
+        }
+    }
+}
+
+void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::FCancelIORequestsTask::DoWork()
+{
+    const ETaskState PreviousState = PendingUpdate->DoLock();
+    for (int32 Index = 0; Index < 8; ++Index)
+    {
+        if (PendingUpdate->IORequests[Index])
+            PendingUpdate->IORequests[Index]->Cancel();
+    }
+    PendingUpdate->DoUnlock(PreviousState);
+}
