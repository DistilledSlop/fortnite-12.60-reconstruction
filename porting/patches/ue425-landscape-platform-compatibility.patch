+	public:
+		explicit FCancelIORequestsTask(FLandscapeMeshMobileStreamIn_IO_AsyncReallocate* Update) : PendingUpdate(Update) {}
+		void DoWork();
+		FORCEINLINE TStatId GetStatId() const { RETURN_QUICK_DECLARE_CYCLE_STAT(FCancelIORequestsTask_LandscapeMeshMobile, STATGROUP_ThreadPoolAsyncTasks); }
+	private:
+		TRefCountPtr<FLandscapeMeshMobileStreamIn_IO_AsyncReallocate> PendingUpdate;
+	};
+	void DoInitiateIO(const FContext& Context);
+	void DoGetIORequestResults(const FContext& Context);
+	void DoCancelIO(const FContext& Context);
+	void ClearIORequest(const FContext& Context);
+	void DoExpandResources(const FContext& Context);
+	void ExpandResources(const FContext& Context);
+	void DoCancel(const FContext& Context);
+	void DoFinishUpdate(const FContext& Context);
+	FVertexBufferRHIRef IntermediateVertexBuffer;
+	void* StagingLODDataArray[8];
+	int64 StagingLODDataSizes[8];
+	IBulkDataIORequest* IORequests[8];
+	FBulkDataIORequestCallBack AsyncFileCallback;
+	bool bHighPrioIORequest;
+};
