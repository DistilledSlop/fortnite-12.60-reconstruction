+// The bytecode imported a native function that is not declared by our reconstructed native classes ("Skipping import Function"
+// in the loader log lists them). Evaluate and discard the parameters, leave Result untouched and continue instead of crashing.
+static void SkipCallToUndeclaredNativeFunction(FFrame& Stack)
+{
+	static TSet<const UFunction*> ReportedCallers;
+	if (!ReportedCallers.Contains(Stack.Node))
+	{
+		ReportedCallers.Add(Stack.Node);
+		UE_LOG(LogScriptCore, Warning, TEXT("Blueprint %s calls an undeclared native function (null import); skipping the call."), *GetPathNameSafe(Stack.Node));
+	}
+	alignas(16) uint8 Scratch[4096];
+	while (*Stack.Code != EX_EndFunctionParms)
+	{
+		FMemory::Memzero(Scratch, sizeof(Scratch));
+		Stack.Step(Stack.Object, Scratch);
+	}
+	Stack.Code++;
+}
+
