+// The original Fortnite client's unique id has type "MCP", which this server has no online subsystem for. The Null
+// session interface asserts when it is given an id of another type, so session (un)registration is skipped for such
+// ids when serving the original client. The original game mode does its own player registration (not ported yet).
+static bool CanUseIdWithSessionInterface(UWorld* World, const FUniqueNetId& UniqueId)
+{
+	static const bool bFortniteOriginalClient = FParse::Param(FCommandLine::Get(), TEXT("FortniteOriginalClient"));
