+// Fortnite 12.60 registers Dev-Sequencer version 11. Unversioned source
+// packages carry tagged channels and 23-byte float values; the stock loader
+// substitutes version 12, whose complete native channel format is different.
+static int32 GetFloatChannelSequencerVersion(FArchive& Ar)
+{
+	const int32 Version = Ar.CustomVer(FSequencerObjectVersion::GUID);
+	if (Ar.IsLoading() && Version >= FSequencerObjectVersion::SerializeFloatChannelCompletely &&
+		FParse::Param(FCommandLine::Get(), TEXT("FortniteLegacySequencer")))
+	{
+		const FLinkerLoad* SourceLinker = Cast<FLinkerLoad>(Ar.GetLinker());
+		if (SourceLinker && SourceLinker->Summary.bUnversioned)
+		{
+			return FSequencerObjectVersion::ModifyLinearKeysForOldInterp; // original version 11
+		}
+	}
+	return Version;
+}
