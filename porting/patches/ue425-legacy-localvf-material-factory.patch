+TRefCountPtr<FMaterialShaderMap> FMaterialShaderMap::CreateLegacySlateMap(
+ const FLegacyMaterialIR& Material, FLegacySlatePrepareOutputs PrepareOutputs, FString& Error)
+{
+ return CreateLegacyMaterialMap(Material, [&](FMaterialShaderMap& Map, const FUniformExpressionSet& Uniforms,
+  const FShaderParametersMetadata& Metadata, FString& OutError) -> bool
+ {
+  auto Fail = [&OutError](const TCHAR* Message) -> bool { OutError = Message; return false; };
+  TArray<FLegacySlateShaderInput> Inputs;
+  if (!PrepareOutputs(Uniforms, Metadata, Inputs, OutError)) return false;
+  static const TCHAR* Names[] = {
+   TEXT("TSlateMaterialShaderVStrue"), TEXT("TSlateMaterialShaderVSfalse"),
+   TEXT("TSlateMaterialShaderPSCustom"), TEXT("TSlateMaterialShaderPSDefault"),
+   TEXT("TSlateMaterialShaderPSBorder"), TEXT("TSlateMaterialShaderPSGrayscaleFont"), TEXT("TSlateMaterialShaderPSColorFont")};
+  if (Inputs.Num() != UE_ARRAY_COUNT(Names)) return Fail(TEXT("Detached original Slate map requires exactly seven records"));
+  TArray<FShaderType*> Types;
+  uint32 Seen = 0;
+  for (FLegacySlateShaderInput& Input : Inputs)
+  {
+   int32 NameIndex = INDEX_NONE;
+   for (int32 I = 0; I < UE_ARRAY_COUNT(Names); ++I) if (Input.TypeName == Names[I]) { NameIndex = I; break; }
+   if (NameIndex == INDEX_NONE || (Seen & (1u << NameIndex))) return Fail(TEXT("Unknown or duplicate original Slate shader type"));
+   Seen |= 1u << NameIndex;
+   FShaderType* Type = FindShaderTypeByName(FHashedName(*Input.TypeName));
+   const auto& Output = Input.Output;
+   const EShaderFrequency ExpectedFrequency = NameIndex < 2 ? SF_Vertex : SF_Pixel;
+   if (!Type || !Type->GetMaterialShaderType() || Type->GetFrequency() != ExpectedFrequency || Input.PermutationId != 0 ||
+       !Output.bSucceeded || Output.Target.GetPlatform() != Material.Platform || Output.Target.GetFrequency() != ExpectedFrequency ||
+       Output.OutputHash == FSHAHash() || Output.ShaderCode.GetReadAccess().Num() == 0)
+    return Fail(TEXT("Invalid output or unregistered current original Slate constructor"));
+   // Verify the supplied identity really is generated from the supplied code/map.
+   const FSHAHash KnownHash = Input.Output.OutputHash;
+   Input.Output.GenerateOutputHash();
+   if (KnownHash != Input.Output.OutputHash) return Fail(TEXT("Original Slate output hash does not match converted code"));
+   Types.Add(Type);
+  }
+  FShaderMapResourceCode* Code = Map.GetResourceCode();
+  for (const auto& Input : Inputs) Code->AddShaderCompilerOutput(Input.Output);
+  // Hash insertion is sorted: resolve only after every output has been added.
+  for (int32 I = 0; I < Inputs.Num(); ++I)
+  {
+   const auto& Input = Inputs[I];
+   FMaterialShaderType::CompiledShaderInitializerType Init(Types[I], Input.PermutationId, Input.Output, Uniforms, Material.OriginalMapHash, nullptr, nullptr, Material.DebugDescription);
+   FShader* Shader = Types[I]->ConstructCompiled(Init);
+   Shader->Finalize(Code, Input.Output.OutputHash);
+   Map.GetMutableContent()->AddShader(Types[I]->GetHashedName(), Input.PermutationId, Shader);
+  }
+  return true;
+ }, Error);
+}
