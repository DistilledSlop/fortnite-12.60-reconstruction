+
+/** One converted original record. Empty VertexFactoryName denotes a material
+ * shader. The only supported nonempty factory is FLocalVertexFactory.
+ * PipelineName is nonempty only for a pipeline with unique stage shaders on the
+ * target platform; shared stages retain their standalone identity instead.
+ */
+struct FLegacyMaterialShaderInput : FLegacySlateShaderInput
+{
+ FString VertexFactoryName;
+ FString PipelineName;
+};
+/** Stage indices address the complete output array, in GetStages() order.
+ * Shared pipelines reference standalone records; unique pipelines reference
+ * records whose PipelineName is this TypeName. No shader record is discarded.
+ */
+struct FLegacyMaterialPipelineInput
+{
+ FString TypeName;
+ FString VertexFactoryName;
+ TArray<int32> StageIndices;
+};
+/** Same metadata lifetime/layout contract as FLegacySlatePrepareOutputs. The
+ * adapter must preserve the complete original record and pipeline inventory,
+ * convert every output including VF/pass bindings, and finalize output hashes.
+ * This factory does not establish owner-specific IsComplete or render parity.
+ */
+using FLegacyMaterialPrepareOutputs = TFunctionRef<bool(
+ const FUniformExpressionSet&, const FShaderParametersMetadata&,
+ TArray<FLegacyMaterialShaderInput>&, TArray<FLegacyMaterialPipelineInput>&, FString&)>;
