+TRefCountPtr<FMaterialShaderMap> FMaterialShaderMap::CreateLegacyLocalVertexFactoryMap(
+ const FLegacyMaterialIR& Material, FLegacyMaterialPrepareOutputs PrepareOutputs, FString& Error)
+{
+ // The frozen map owns its copied content. Keep the temporary mesh map and
+ // unique pipeline shaders alive through freezing; TMemoryImagePtr is nonowning
+ // and the ordinary pipeline destructor only clears its stage pointers.
+ TUniquePtr<FMeshMaterialShaderMap> MeshOwner;
+ TArray<TUniquePtr<FShader, FLegacyShaderDeleter>> UniqueShaderOwners;
+ return CreateLegacyMaterialMap(Material, [&](FMaterialShaderMap& Map, const FUniformExpressionSet& Uniforms,
+  const FShaderParametersMetadata& Metadata, FString& OutError) -> bool
+ {
+  auto Fail = [&OutError](const TCHAR* Message) -> bool { OutError = Message; return false; };
+  TArray<FLegacyMaterialShaderInput> Inputs;
+  TArray<FLegacyMaterialPipelineInput> Pipelines;
+  if (!PrepareOutputs(Uniforms, Metadata, Inputs, Pipelines, OutError)) return false;
+  if (Inputs.Num() == 0 || Inputs.Num() > 4096 || Pipelines.Num() > 1024)
+   return Fail(TEXT("Invalid original LocalVF shader/pipeline inventory size"));
+  FVertexFactoryType* LocalVF = FVertexFactoryType::GetVFByName(FHashedName(TEXT("FLocalVertexFactory")));
+  if (!LocalVF || !LocalVF->IsUsedWithMaterials())
+   return Fail(TEXT("Original FLocalVertexFactory constructor is unavailable"));
+
+  TArray<FShaderType*> Types;
+  TArray<const FShaderPipelineType*> PipelineTypes;
+  TArray<int32> Owners, References;
+  Owners.Init(INDEX_NONE, Inputs.Num());
+  References.Init(0, Inputs.Num());
+  bool bHasLocalVF = false;
+  for (int32 I = 0; I < Inputs.Num(); ++I)
+  {
+   auto& Input = Inputs[I];
+   const bool bMesh = !Input.VertexFactoryName.IsEmpty();
+   if (bMesh && Input.VertexFactoryName != TEXT("FLocalVertexFactory"))
+    return Fail(TEXT("Unsupported original mesh vertex factory"));
+   bHasLocalVF |= bMesh;
+   FShaderType* Type = FindShaderTypeByName(FHashedName(*Input.TypeName));
+   if (!Type || Input.TypeName != Type->GetName() ||
+       (bMesh ? !Type->GetMeshMaterialShaderType() : !Type->GetMaterialShaderType()) ||
+       Input.PermutationId < 0 || Input.PermutationId >= Type->GetPermutationCount() ||
+       Type->GetFrequency() >= SF_NumGraphicsFrequencies || !Input.Output.bSucceeded ||
+       Input.Output.Target.GetPlatform() != Material.Platform || Input.Output.Target.GetFrequency() != Type->GetFrequency() ||
+       Input.Output.OutputHash == FSHAHash() || Input.Output.ShaderCode.GetReadAccess().Num() == 0)
+    return Fail(TEXT("Invalid original material/LocalVF constructor, permutation or output target"));
+   const FSHAHash KnownHash = Input.Output.OutputHash;
+   Input.Output.GenerateOutputHash();
+   if (KnownHash != Input.Output.OutputHash)
+    return Fail(TEXT("Original material/LocalVF output hash differs from converted code"));
+   // Compiler outputs must enter construction unbound. A pre-set bBound bit
+   // cannot prove that the current VF/material constructor consumed a binding.
+   for (auto& Parameter : Input.Output.ParameterMap.ParameterMap)
+   {
+    if (Parameter.Key.IsEmpty() || Parameter.Value.Type >= EShaderParameterType::Num || Parameter.Value.Size == 0)
+     return Fail(TEXT("Invalid original material/LocalVF resource parameter allocation"));
+    Parameter.Value.bBound = false;
+   }
+   TArray<FString> ValidationErrors;
+   if (!Type->ValidateCompiledResult(Material.Platform, Input.Output.ParameterMap, ValidationErrors))
+    return Fail(TEXT("Original material/LocalVF output failed constructor parameter validation"));
+   for (int32 J = 0; J < I; ++J)
+    if (Types[J] == Type && Inputs[J].PermutationId == Input.PermutationId &&
+        Inputs[J].VertexFactoryName == Input.VertexFactoryName && Inputs[J].PipelineName == Input.PipelineName)
+     return Fail(TEXT("Duplicate original material/LocalVF shader identity"));
+   Types.Add(Type);
+  }
+  if (!bHasLocalVF) return Fail(TEXT("Original LocalVF factory requires mesh shader records"));
+  for (int32 I = 0; I < Pipelines.Num(); ++I)
+  {
+   const auto& Input = Pipelines[I];
+   const FShaderPipelineType* Type = FShaderPipelineType::GetShaderPipelineTypeByName(FHashedName(*Input.TypeName));
+   const bool bMesh = !Input.VertexFactoryName.IsEmpty();
+   if (!Type || Input.TypeName != Type->GetName() ||
+       (bMesh && Input.VertexFactoryName != TEXT("FLocalVertexFactory")) ||
+       (bMesh ? !Type->IsMeshMaterialTypePipeline() : !Type->IsMaterialTypePipeline()) ||
+       Input.StageIndices.Num() != Type->GetStages().Num())
+    return Fail(TEXT("Invalid original pipeline type, vertex factory or stage count"));
+   for (int32 J = 0; J < I; ++J)
+    if (PipelineTypes[J] == Type && Pipelines[J].VertexFactoryName == Input.VertexFactoryName)
+     return Fail(TEXT("Duplicate original pipeline identity"));
+   const bool bUnique = Type->ShouldOptimizeUnusedOutputs(Material.Platform);
+   uint32 Frequencies = 0;
+   for (int32 Stage = 0; Stage < Input.StageIndices.Num(); ++Stage)
+   {
+    const int32 Index = Input.StageIndices[Stage];
+    if (!Inputs.IsValidIndex(Index) || Types[Index] != Type->GetStages()[Stage] ||
+        Inputs[Index].VertexFactoryName != Input.VertexFactoryName ||
+        (bUnique ? Inputs[Index].PipelineName != Input.TypeName : !Inputs[Index].PipelineName.IsEmpty()))
+     return Fail(TEXT("Original pipeline stage identity/order or sharing differs from current type"));
+    const uint32 Frequency = 1u << Types[Index]->GetFrequency();
+    if ((Frequencies & Frequency) || (bUnique && Owners[Index] != INDEX_NONE))
+     return Fail(TEXT("Duplicate original pipeline frequency or unique stage ownership"));
+    Frequencies |= Frequency;
+    if (bUnique) Owners[Index] = I;
+    ++References[Index];
+   }
+   PipelineTypes.Add(Type);
+  }
+  for (int32 I = 0; I < Inputs.Num(); ++I)
+   if ((!Inputs[I].PipelineName.IsEmpty() && (Owners[I] == INDEX_NONE || References[I] != 1)) ||
+       (Inputs[I].PipelineName.IsEmpty() && Owners[I] != INDEX_NONE))
+    return Fail(TEXT("Unowned or multiply owned original unique pipeline shader"));
+
+  // Validate the entire inventory before mutating content. All code must be
+  // inserted before resolving sorted resource indices in FShader::Finalize.
+  FShaderMapResourceCode* Code = Map.GetResourceCode();
+  for (const auto& Input : Inputs) Code->AddShaderCompilerOutput(Input.Output);
+  FMaterialShaderMapContent* Content = Map.GetMutableContent();
+  MeshOwner.Reset(new FMeshMaterialShaderMap(Material.Platform, LocalVF));
+  FMeshMaterialShaderMap* Mesh = MeshOwner.Get();
+  TArray<FShaderPipeline*> ConstructedPipelines;
+  for (int32 I = 0; I < Pipelines.Num(); ++I)
+  {
+   FShaderPipeline* Pipeline = new FShaderPipeline(PipelineTypes[I]);
+   (Pipelines[I].VertexFactoryName.IsEmpty() ? static_cast<FShaderMapContent*>(Content) : Mesh)->AddShaderPipeline(Pipeline);
+   ConstructedPipelines.Add(Pipeline);
+  }
+  TArray<FShader*> Shaders;
+  for (int32 I = 0; I < Inputs.Num(); ++I)
+  {
+   auto& Input = Inputs[I];
+   const bool bMesh = !Input.VertexFactoryName.IsEmpty();
+   const FShaderPipelineType* PipelineType = Owners[I] == INDEX_NONE ? nullptr : PipelineTypes[Owners[I]];
+   FShader* Shader;
+   if (bMesh)
+   {
+    FMeshMaterialShaderType::CompiledShaderInitializerType Init(Types[I], Input.PermutationId, Input.Output,
+     Uniforms, Material.OriginalMapHash, Material.DebugDescription, PipelineType, LocalVF);
+    Shader = Types[I]->ConstructCompiled(Init);
+   }
+   else
+   {
+    FMaterialShaderType::CompiledShaderInitializerType Init(Types[I], Input.PermutationId, Input.Output,
+     Uniforms, Material.OriginalMapHash, PipelineType, nullptr, Material.DebugDescription);
+    Shader = Types[I]->ConstructCompiled(Init);
+   }
+   // Retain each unfrozen unique stage until freezing or rejection completes.
+   if (Owners[I] != INDEX_NONE)
+   {
+    UniqueShaderOwners.Emplace(Shader);
+    ConstructedPipelines[Owners[I]]->AddShader(Shader, Input.PermutationId);
+   }
+   else (bMesh ? static_cast<FShaderMapContent*>(Mesh) : Content)->AddShader(Types[I]->GetHashedName(), Input.PermutationId, Shader);
+   Shaders.Add(Shader);
+   Shader->Finalize(Code, Input.Output.OutputHash);
+   // Binding mutates bBound without affecting the output hash. Match the normal
+   // compiler finish contract, but report an unsupported binding instead of a fatal.
+   for (const auto& Parameter : Input.Output.ParameterMap.GetParameterMap())
+    if (!Parameter.Value.bBound)
+     return Fail(TEXT("Original material/LocalVF output contains an unbound resource parameter"));
+  }
+  for (int32 I = 0; I < Pipelines.Num(); ++I)
+  {
+   if (!PipelineTypes[I]->ShouldOptimizeUnusedOutputs(Material.Platform))
+    for (int32 Index : Pipelines[I].StageIndices)
+     ConstructedPipelines[I]->AddShader(Shaders[Index], Inputs[Index].PermutationId);
+   ConstructedPipelines[I]->Validate(PipelineTypes[I]);
+  }
+  Content->AddMeshShaderMap(LocalVF, Mesh);
+  return true;
+ }, Error);
+}
