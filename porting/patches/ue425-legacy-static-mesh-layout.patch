+// Probe-only: Fortnite 12.60 cooked static meshes carry newer custom versions in their package summary but do
+// not serialize bForceOpaque, bShouldExpandTo32Bit or the ray tracing geometry array (see
+// porting/patches/cue4parse-fortnite-12.60-static-mesh.patch). Enabled with -FortniteLegacyStaticMeshLayout.
+bool FortniteUseLegacyStaticMeshLayout(FArchive& Ar)
+{
+	static const bool bEnabled = FParse::Param(FCommandLine::Get(), TEXT("FortniteLegacyStaticMeshLayout"));
+	if (!bEnabled || !Ar.IsLoading())
+	{
+		return false;
+	}
+	// -FortniteStockLayoutList=<file> names (one long package name per line) the packages that this engine cooked
+	// and that therefore keep the stock layout. Every other package is a recovered 12.60 Windows cook.
+	static TSet<FString> StockPackages = []()
+	{
+		TSet<FString> Result;
+		FString ListPath;
+		TArray<FString> Lines;
+		if (FParse::Value(FCommandLine::Get(), TEXT("FortniteStockLayoutList="), ListPath) && FFileHelper::LoadFileToStringArray(Lines, *ListPath))
+		{
+			for (const FString& Line : Lines)
+			{
+				Result.Add(Line.TrimStartAndEnd());
+			}
+		}
+		return Result;
+	}();
+	const FLinker* Linker = Ar.GetLinker();
+	if (Linker && Linker->LinkerRoot && StockPackages.Contains(Linker->LinkerRoot->GetName()))
+	{
+		return false;
+	}
+	return true;
+}
