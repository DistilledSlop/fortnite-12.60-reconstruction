+// Probe-only: Fortnite 12.60 cooked static meshes carry newer custom versions in their package summary but do
+// not serialize bForceOpaque, bShouldExpandTo32Bit or the ray tracing geometry array (see
+// porting/patches/cue4parse-fortnite-12.60-static-mesh.patch). Enabled with -FortniteLegacyStaticMeshLayout.
+bool FortniteUseLegacyStaticMeshLayout(FArchive& Ar)
+{
+	static const bool bEnabled = FParse::Param(FCommandLine::Get(), TEXT("FortniteLegacyStaticMeshLayout"));
+	if (!bEnabled || !Ar.IsLoading())
+	{
+		return false;
+	}
+	// Engine, Niagara, Paper2D and Water content in the stage is cooked by this engine and keeps the stock layout.
+	const FLinker* Linker = Ar.GetLinker();
+	if (Linker && Linker->LinkerRoot)
+	{
+		const FString Name = Linker->LinkerRoot->GetName();
+		if (Name.StartsWith(TEXT("/Engine/")) || Name.StartsWith(TEXT("/Niagara/")) || Name.StartsWith(TEXT("/Paper2D/")) || Name.StartsWith(TEXT("/Water/")))
+		{
+			return false;
+		}
+	}
+	return true;
+}
