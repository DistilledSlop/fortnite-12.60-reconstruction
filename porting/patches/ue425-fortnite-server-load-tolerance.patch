@@ -3426,8 +3426,24 @@ uint32 FNetGUIDCache::GetNetworkChecksum( UObject* Obj )
 
 	// If Obj is already a class, we can use that directly
 	UClass* Class = Cast< UClass >( Obj );
+	UClass* ChecksumClass = ( Class != NULL ) ? Class : Obj->GetClass();
 
-	return ( Class != NULL ) ? GetClassNetworkChecksum( Class ) : GetClassNetworkChecksum( Obj->GetClass() );
+	// Fortnite original client: the shipping client's fork of engine classes (UBrushComponent, UStaticMeshComponent...)
+	// has a different layout checksum than stock 4.25, and the client breaks the connection on a mismatch. Send 0
+	// ("not checked") for native classes of engine modules and plugins (/Script/Engine, /Script/Landscape, ...); Fortnite's
+	// own classes (/Script/Fortnite*) keep their real checksum. /Script/Landscape was added after run 29: the client dropped
+	// on LandscapeHeightfieldCollisionComponent (the pawn's movement base).
+	static const bool bFortniteSkipEngineClassChecksum = FParse::Param( FCommandLine::Get(), TEXT( "FortniteSkipEngineClassNetChecksum" ) );
+	if ( bFortniteSkipEngineClassChecksum && ChecksumClass && ChecksumClass->HasAnyClassFlags( CLASS_Native ) )
+	{
+		const FString PackageName = ChecksumClass->GetOutermost()->GetName();
+		if ( PackageName.StartsWith( TEXT( "/Script/" ) ) && !PackageName.StartsWith( TEXT( "/Script/Fortnite" ) ) )
+		{
+			return 0;
+		}
+	}
+
+	return GetClassNetworkChecksum( ChecksumClass );
