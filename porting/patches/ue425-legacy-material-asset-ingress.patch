+bool FMaterialResourceProxyReader::GetResourceRange(int64 Position, int64& Begin, int64& End) const
+{
+ if (IsError()) return false;
+ for (int32 Index = 0; Index < ResourceLocations.Num(); ++Index)
+ {
+  if (Position == ResourceLocations[Index].Offset)
+  {
+   Begin = Position;
+   End = Index + 1 < ResourceLocations.Num() ? ResourceLocations[Index + 1].Offset : ResourceBytes;
+   return End > Begin;
+  }
+ }
+ return false;
+}
