+// Copyright Epic Games, Inc. All Rights Reserved.
+#include "LegacyMaterialAsset.h"
+#include "MaterialShared.h"
+#include "Materials/Material.h"
+#include "Materials/MaterialInstance.h"
+#include "MaterialShaderMapLayout.h"
+#include "MeshMaterialShaderType.h"
+#include "VertexFactory.h"
+
+bool ValidateLegacyMaterialAsset(FMaterialResource& Resource, UMaterialInterface* Owner)
+{
+ check(IsInGameThread());
+ FMaterialShaderMap* Map = Resource.GetGameThreadShaderMap();
+ if (!Resource.HasLegacyMaterialAsset() && !(Map && Map->GetLegacyMaterialProvenance().IsValid())) return true;
+ UMaterial* Base = Owner ? Owner->GetMaterial() : nullptr;
+ if (!Map || !Base)
+ {
+  UE_LOG(LogMaterial, Error, TEXT("Legacy material has no actual owner or map"));
+  Resource.ReleaseShaderMap();
+  return false;
+ }
+ const FMaterialShaderMapId& Id = Map->GetShaderMapId();
+ if (Id.FeatureLevel >= ERHIFeatureLevel::Num || Id.QualityLevel > EMaterialQualityLevel::Num || Map->GetShaderPlatform() != GMaxRHIShaderPlatform)
+ {
+  UE_LOG(LogMaterial, Error, TEXT("Legacy material %s has incompatible platform/quality/feature"), *Owner->GetPathName());
+  Resource.ReleaseShaderMap();
+  return false;
+ }
+ TArray<bool, TInlineAllocator<EMaterialQualityLevel::Num>> Usage;
+ Base->GetQualityLevelUsage(Usage, Map->GetShaderPlatform());
+ TUniquePtr<FMaterialResource> Validation(Cast<UMaterialInstance>(Owner) ? CastChecked<UMaterialInstance>(Owner)->AllocatePermutationResource() : Base->AllocateResource());
+ const bool QualityHasDifferentNodes = STORE_ONLY_ACTIVE_SHADERMAPS || (Id.QualityLevel < EMaterialQualityLevel::Num && Usage[Id.QualityLevel]);
+ Validation->SetMaterial(Base, Id.QualityLevel, QualityHasDifferentNodes, Id.FeatureLevel, Cast<UMaterialInstance>(Owner));
+ const FMaterialShaderParameters Parameters(Validation.Get());
+ const FMaterialShaderMapLayout& Layout = AcquireMaterialShaderMapLayout(Map->GetShaderPlatform(), Parameters);
+ const FMaterialShaderMapContent* Content = Map->GetContent();
+ int32 Missing = 0, Required = 0;
+ auto Shader = [&](const FShaderLayoutEntry& Entry, FVertexFactoryType* VF, const FMeshMaterialShaderMap* Mesh)
+ {
+  if (Validation->ShouldCache(Map->GetShaderPlatform(), Entry.ShaderType, VF))
+  {
+   ++Required;
+   if (!(VF ? Mesh && Mesh->HasShader(Entry.ShaderType, Entry.PermutationId) : Content->HasShader(Entry.ShaderType, Entry.PermutationId)))
+   {
+    ++Missing;
+    UE_LOG(LogMaterial, Error, TEXT("Legacy owner %s missing shader=%s permutation=%d VF=%s"), *Owner->GetPathName(), Entry.ShaderType->GetName(), Entry.PermutationId, VF ? VF->GetName() : TEXT("none"));
+   }
+  }
+ };
+ auto Pipeline = [&](const FShaderPipelineType* Entry, FVertexFactoryType* VF, const FMeshMaterialShaderMap* Mesh)
+ {
+  if (Validation->ShouldCachePipeline(Map->GetShaderPlatform(), Entry, VF))
+  {
+   ++Required;
+   if (!(VF ? Mesh && Mesh->HasShaderPipeline(Entry) : Content->HasShaderPipeline(Entry)))
+   {
+    ++Missing;
+    UE_LOG(LogMaterial, Error, TEXT("Legacy owner %s missing pipeline=%s VF=%s"), *Owner->GetPathName(), Entry->GetName(), VF ? VF->GetName() : TEXT("none"));
+   }
+  }
+ };
+ for (const FShaderLayoutEntry& Entry : Layout.Shaders) Shader(Entry, nullptr, nullptr);
+ for (const FShaderPipelineType* Entry : Layout.ShaderPipelines) Pipeline(Entry, nullptr, nullptr);
+ for (const FMeshMaterialShaderMapLayout& Mesh : Layout.MeshShaderMaps)
+ {
+  const FMeshMaterialShaderMap* Candidate = Map->GetMeshShaderMap(Mesh.VertexFactoryType);
+  for (const FShaderLayoutEntry& Entry : Mesh.Shaders) Shader(Entry, Mesh.VertexFactoryType, Candidate);
+  for (const FShaderPipelineType* Entry : Mesh.ShaderPipelines) Pipeline(Entry, Mesh.VertexFactoryType, Candidate);
+ }
+ const bool Complete = Map->IsComplete(Validation.Get(), false) && Missing == 0;
+ UE_LOG(LogMaterial, Display, TEXT("Legacy actual-owner completeness owner=%s domain=%d blend=%d shading=%s quality=%d feature=%d flags=%llu required=%d missing=%d complete=%d"),
+  *Owner->GetPathName(), int32(Validation->GetMaterialDomain()), int32(Validation->GetBlendMode()), *GetShadingModelFieldString(Validation->GetShadingModels()), int32(Id.QualityLevel), int32(Id.FeatureLevel), (unsigned long long)Parameters.PackedFlags, Required, Missing, int32(Complete));
+ if (!Complete) Resource.ReleaseShaderMap();
+ return Complete;
+}
