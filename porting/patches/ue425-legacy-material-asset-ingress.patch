diff --git a/Engine/Source/Runtime/Engine/Public/LegacyMaterialAsset.h b/Engine/Source/Runtime/Engine/Public/LegacyMaterialAsset.h
new file mode 100644
index 000000000..8335355b7
--- /dev/null
+++ b/Engine/Source/Runtime/Engine/Public/LegacyMaterialAsset.h
@@ -0,0 +1,31 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+#pragma once
+#include "CoreMinimal.h"
+#include "Misc/SecureHash.h"
+class FMaterialShaderMap;
+/** Immutable lifetime anchor; adapters may retain their complete decoded representation. */
+struct ENGINE_API FLegacyMaterialAssetProvenance
+{
+ virtual ~FLegacyMaterialAssetProvenance() = default;
+ TArray<uint8> OriginalResource;
+ FSHAHash ResourceHash;
+ FString SourceIdentity;
+ uint32 OriginalShaderRecordCount = 0;
+};
+/** Positions use Archive coordinates; Names and OwnerPath are borrowed only for the callback.
+ * Archive is positioned after the cooked/valid flags. Preserve state when declining. */
+struct FLegacyMaterialAssetContext
+{
+ FArchive& Archive;
+ const FString& OwnerPath;
+ int64 ResourceBegin;
+ int64 ResourceEnd;
+ TArrayView<const FName> Names;
+};
+enum class ELegacyMaterialAssetResult : uint8 { NotApplicable, Converted, Failed };
+using FLegacyMaterialAssetProvider = ELegacyMaterialAssetResult (*)(
+ const FLegacyMaterialAssetContext&, TRefCountPtr<FMaterialShaderMap>&,
+ TSharedPtr<const FLegacyMaterialAssetProvenance, ESPMode::ThreadSafe>&, FString&);
+/** Register once on the game thread, before async asset loading starts. Null unregisters after loading stops. */
+ENGINE_API void RegisterLegacyMaterialAssetProvider(FLegacyMaterialAssetProvider Provider);
+ENGINE_API bool ValidateLegacyMaterialAsset(class FMaterialResource& Resource, class UMaterialInterface* Owner);
