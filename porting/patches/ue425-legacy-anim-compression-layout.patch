+		SerializeView(Ar, LegacyData.CompressedTrackOffsets);
+		SerializeView(Ar, LegacyData.CompressedScaleOffsets.OffsetData);
+		Ar << LegacyData.CompressedScaleOffsets.StripSize;
+		SerializeView(Ar, LegacyData.CompressedByteStream);
+		AnimationFormat_SetInterfaceLinks(LegacyData);
+	}
