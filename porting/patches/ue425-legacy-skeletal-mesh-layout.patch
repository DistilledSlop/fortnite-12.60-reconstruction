+// Original Fortnite 12.60 cooked skeletal meshes (unversioned packages, UE 4.23 based) serialize the skin weight
+// buffer in the pre-UnlimitedBoneInfluences layout: bExtraBoneInfluences, Stride, NumVertices, then the bulk array of
+// legacy weight entries (8 bit bone indices, no bUse16BitBoneIndex flag), and no lookup buffer. Unversioned packages
+// report the newest custom versions, so the version checks alone would select the new layout.
+// See porting/patches/ue425-legacy-skeletal-mesh-layout.patch. On by default; -FortniteNoLegacySkeletalMesh disables it.
+static bool FortniteUseLegacySkinWeightLayout(FArchive& Ar)
+{
+	static const bool bDisabled = FParse::Param(FCommandLine::Get(), TEXT("FortniteNoLegacySkeletalMesh"));
+	return !bDisabled && Ar.IsLoading() && Ar.GetLinker() && Ar.GetLinker()->Summary.bUnversioned;
+}
 
