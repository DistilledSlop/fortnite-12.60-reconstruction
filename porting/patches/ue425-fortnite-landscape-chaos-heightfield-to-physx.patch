+// Capture a bounded sample of the original cooked stream for offline layout analysis.
+// CookedCollisionData is an opaque byte array here; it carries no FArchive version context.
+static void FortniteDumpLandscapeHeightfield(const TArray<uint8>& Blob, const FString& ComponentPath,
+	int32 FullQuads, int32 SimpleQuads, int32 MaterialCount)
+{
+	FString Directory;
+	if (!FParse::Value(FCommandLine::Get(), TEXT("FortniteDumpLandscapeHeightfield="), Directory))
+		return;
+	static FCriticalSection Lock;
+	static TSet<FIntPoint> SavedLayouts;
+	static bool bDumpDisabled = false;
+	FScopeLock Guard(&Lock);
+	if (bDumpDisabled)
+		return;
+	if (Directory.IsEmpty() || FPaths::IsRelative(Directory))
+	{
+		UE_LOG(LogLandscape, Warning, TEXT("FortniteDumpLandscapeHeightfield requires an absolute output directory"));
+		bDumpDisabled = true;
+		return;
+	}
+	const FIntPoint Layout(FullQuads, SimpleQuads);
+	if (SavedLayouts.Num() >= 4 || SavedLayouts.Contains(Layout))
+		return;
+	if (!IFileManager::Get().MakeDirectory(*Directory, true))
+	{
+		UE_LOG(LogLandscape, Warning, TEXT("Could not create landscape dump directory %s"), *Directory);
+		bDumpDisabled = true;
+		return;
+	}
+	const FString Stem = FString::Printf(TEXT("landscape_%d_%d_%s"), FullQuads, SimpleQuads,
+		*FGuid::NewGuid().ToString(EGuidFormats::Digits));
+	const FString BlobPath = FPaths::Combine(Directory, Stem + TEXT(".bin"));
+	const FString MetaPath = FPaths::Combine(Directory, Stem + TEXT(".txt"));
+	const FString Metadata = FString::Printf(
+		TEXT("component=%s\nfull_quads=%d\nsimple_quads=%d\nbytes=%d\nphysical_material_count=%d\narchive_custom_versions=unavailable_at_opaque_cooked_byte_array\n"),
+		*ComponentPath, FullQuads, SimpleQuads, Blob.Num(), MaterialCount);
+	if (!FFileHelper::SaveArrayToFile(Blob, *BlobPath))
+	{
+		UE_LOG(LogLandscape, Warning, TEXT("Could not save landscape blob %s"), *BlobPath);
+		bDumpDisabled = true;
+		return;
+	}
+	if (!FFileHelper::SaveStringToFile(Metadata, *MetaPath))
+	{
+		IFileManager::Get().Delete(*BlobPath);
+		UE_LOG(LogLandscape, Warning, TEXT("Could not save landscape metadata %s"), *MetaPath);
+		bDumpDisabled = true;
+		return;
+	}
+	SavedLayouts.Add(Layout);
+	UE_LOG(LogLandscape, Display, TEXT("Saved landscape heightfield sample %s (%d bytes)"), *BlobPath, Blob.Num());
+}
+// Exact original 12.60 profile observed in full127/simple0 and full63/simple0 dumps.
+// CookedCollisionData carries no archive versions: reject other layouts rather than
+// guessing offsets. Original simple-object framing still needs a runtime fixture.
+struct FFortniteHeightfieldCursor
+{
+	const TArray<uint8>& Blob;
+	int64 Position = 0;
+	const TCHAR* Error = TEXT("unsupported original Chaos profile");
+
+	explicit FFortniteHeightfieldCursor(const TArray<uint8>& InBlob) : Blob(InBlob) {}
+
+	bool Check(bool bValid, const TCHAR* Reason)
+	{
+		if (!bValid) Error = Reason;
+		return bValid;
+	}
+
+	bool Bytes(const uint8*& Out, int64 Size)
+	{
+		if (!Check(Size >= 0 && Size <= int64(Blob.Num()) - Position, TEXT("truncated field"))) return false;
+		Out = Blob.GetData() + Position;
+		Position += Size;
+		return true;
+	}
+
+	template<typename T> bool Read(T& Out)
+	{
+		const uint8* Data;
+		if (!Bytes(Data, sizeof(T))) return false;
+		FMemory::Memcpy(&Out, Data, sizeof(T));
+		return true;
+	}
+
+	bool Boolean(bool& Out)
+	{
+		uint32 Value;
+		if (!Read(Value) || !Check(Value <= 1, TEXT("invalid archive bool"))) return false;
+		Out = Value != 0;
+		return true;
+	}
+};
+
+struct FFortniteChaosHeightfield
+{
+	int32 NumVerts = 0;
+	const uint8* Heights = nullptr;
+	float Scale[3];
+	float MinValue, MaxValue, Range, HeightPerUnit;
+	int32 NumMaterials = 0;
+	const uint8* Materials = nullptr;
+	float GridMin[2], GridMax[2], GridDx[2];
+	int32 GridCells[2];
+	// Original fixtures contain invalid cached flattened bounds. Preserve the bytes,
+	// but never use them for geometry or reject otherwise valid original data for them.
+	const uint8* FlattenedBounds = nullptr;
+	float BoundsMin[3], BoundsMax[3];
+};
+
+static bool FortniteReadChaosHeightfield(FFortniteHeightfieldCursor& Cursor, int32 Quads,
+	int32 ExpectedTag, int32 PhysicalMaterialCount, FFortniteChaosHeightfield& Out)
+{
+	if (!Cursor.Check(Quads > 0 && Quads < 65535 && PhysicalMaterialCount > 0, TEXT("component dimensions/material table"))) return false;
+	bool bExists, bConvex, bCollide;
+	int32 Tag, RealSize, StorageSize, HeightCount;
+	uint8 Type;
+	if (!Cursor.Boolean(bExists) || !Cursor.Check(bExists, TEXT("missing required heightfield")) ||
+		!Cursor.Read(Tag) || !Cursor.Read(Type) || !Cursor.Boolean(bConvex) || !Cursor.Boolean(bCollide) ||
+		!Cursor.Read(RealSize) || !Cursor.Read(StorageSize) || !Cursor.Read(HeightCount)) return false;
+	const int64 N = int64(Quads) + 1;
+	const int64 NumSamples = N * N;
+	if (!Cursor.Check(Tag == ExpectedTag && Type == 12 && !bConvex && bCollide && RealSize == 4 && StorageSize == 2,
+		TEXT("unsupported object framing/types")) ||
+		!Cursor.Check(NumSamples <= MAX_int32 && HeightCount == NumSamples, TEXT("height count")) ||
+		!Cursor.Bytes(Out.Heights, NumSamples * 2) || !Cursor.Read(Out.Scale) ||
+		!Cursor.Read(Out.MinValue) || !Cursor.Read(Out.MaxValue)) return false;
+	uint16 Rows, Cols;
+	if (!Cursor.Read(Rows) || !Cursor.Read(Cols) || !Cursor.Read(Out.Range) || !Cursor.Read(Out.HeightPerUnit)) return false;
+	if (!Cursor.Check(Rows == N && Cols == N, TEXT("serialized dimensions"))) return false;
+	Out.NumVerts = int32(N);
+	// The shape setup already supplies landscape XY and Z scales. Both original
+	// fixtures use unit GeomData.Scale; other scales must not be silently ignored.
+	for (int32 Axis = 0; Axis < 3; ++Axis)
+		if (!Cursor.Check(Out.Scale[Axis] == 1.f, TEXT("unsupported geometry scale"))) return false;
+	if (!Cursor.Check(FMath::IsFinite(Out.MinValue) && FMath::IsFinite(Out.MaxValue) &&
+		FMath::IsFinite(Out.Range) && FMath::IsFinite(Out.HeightPerUnit) &&
+		Out.MinValue <= Out.MaxValue && Out.Range >= 0.f && Out.HeightPerUnit >= 0.f,
+		TEXT("invalid height interval"))) return false;
+	const float Tolerance = FMath::Max(0.002f, Out.Range * 2.e-6f);
+	if (!Cursor.Check(FMath::Abs((Out.MaxValue - Out.MinValue) - Out.Range) <= Tolerance &&
+		FMath::Abs(Out.HeightPerUnit * 65535.f - Out.Range) <= Tolerance, TEXT("inconsistent height range"))) return false;
+	for (int32 Index = 0; Index < HeightCount; ++Index)
+	{
+		uint16 Height;
+		FMemory::Memcpy(&Height, Out.Heights + int64(Index) * 2, sizeof(Height));
+		const float Value = Out.MinValue + Height * Out.HeightPerUnit;
+		// Check before RoundToInt and reject unrepresentable heights instead of clamping.
+		if (!Cursor.Check(FMath::IsFinite(Value) && Value <= Out.MaxValue + Tolerance &&
+			Value >= -32768.5f && Value < 32767.5f, TEXT("unrepresentable height"))) return false;
+		const int32 Rounded = FMath::RoundToInt(Value);
+		if (!Cursor.Check(Rounded >= -32768 && Rounded <= 32767, TEXT("unrepresentable rounded height"))) return false;
+	}
+	if (!Cursor.Read(Out.NumMaterials) ||
+		!Cursor.Check(Out.NumMaterials == 1 || Out.NumMaterials == int64(Quads) * Quads, TEXT("material cell count")) ||
+		!Cursor.Bytes(Out.Materials, Out.NumMaterials)) return false;
+	for (int32 Index = 0; Index < Out.NumMaterials; ++Index)
+	{
+		const uint8 Material = Out.Materials[Index];
+		if (!Cursor.Check(Material == 255 || (Material < PxHeightFieldMaterial::eHOLE && Material < PhysicalMaterialCount),
+			TEXT("unrepresentable material index"))) return false;
+	}
+	if (!Cursor.Read(Out.GridMin) || !Cursor.Read(Out.GridMax) || !Cursor.Read(Out.GridCells) ||
+		!Cursor.Read(Out.GridDx) || !Cursor.Bytes(Out.FlattenedBounds, 16) ||
+		!Cursor.Read(Out.BoundsMin) || !Cursor.Read(Out.BoundsMax)) return false;
+	for (int32 Axis = 0; Axis < 2; ++Axis)
+	{
+		if (!Cursor.Check(Out.GridMin[Axis] == 0.f && Out.GridMax[Axis] == Quads &&
+			Out.GridCells[Axis] == Quads && Out.GridDx[Axis] == 1.f, TEXT("grid disagreement"))) return false;
+	}
+	for (int32 Axis = 0; Axis < 3; ++Axis)
+	{
+		if (!Cursor.Check(FMath::IsFinite(Out.BoundsMin[Axis]) && FMath::IsFinite(Out.BoundsMax[Axis]) &&
+			Out.BoundsMin[Axis] <= Out.BoundsMax[Axis], TEXT("invalid local AABB"))) return false;
+	}
+	return Cursor.Check(Out.BoundsMin[0] <= 0.f && Out.BoundsMin[1] <= 0.f &&
+		Out.BoundsMax[0] >= Quads && Out.BoundsMax[1] >= Quads &&
+		Out.BoundsMin[2] <= Out.MinValue + Tolerance && Out.BoundsMax[2] >= Out.MaxValue - Tolerance,
+		TEXT("local AABB does not enclose geometry"));
+}
+
+static PxHeightField* FortniteCookPhysXHeightfield(const FFortniteChaosHeightfield& Field, bool bIsMirrored)
+{
+	const int32 N = Field.NumVerts;
+	TArray<PxHeightFieldSample> Samples;
+	Samples.AddZeroed(N * N);
+	for (int32 RowIndex = 0; RowIndex < N; ++RowIndex)
+	{
+		for (int32 ColIndex = 0; ColIndex < N; ++ColIndex)
+		{
+			const int32 Src = ColIndex * N + (bIsMirrored ? RowIndex : N - RowIndex - 1);
+			uint16 Height;
+			FMemory::Memcpy(&Height, Field.Heights + int64(Src) * 2, sizeof(Height));
+			PxHeightFieldSample& Sample = Samples[RowIndex * N + ColIndex];
+			Sample.height = PxI16(FMath::RoundToInt(Field.MinValue + Height * Field.HeightPerUnit));
+			if (RowIndex < N - 1 && ColIndex < N - 1)
+			{
+				// Materials are cells with stride N-1, not vertices with stride N.
+				const int32 Cell = ColIndex * (N - 1) + (bIsMirrored ? RowIndex : N - 2 - RowIndex);
+				const uint8 Material = Field.Materials[Field.NumMaterials == 1 ? 0 : Cell];
+				const PxU8 PhysXMaterial = Material == 255 ? PxU8(PxHeightFieldMaterial::eHOLE) : Material;
+				Sample.materialIndex0 = PhysXMaterial;
+				Sample.materialIndex1 = PhysXMaterial;
+			}
+			// Chaos splits source00--11. The non-mirrored reflection maps it to
+			// destination01--10 (clear); the mirrored transpose needs00--11 (set).
+			if (bIsMirrored) Sample.setTessFlag();
+		}
+	}
+	PxHeightFieldDesc Desc;
+	Desc.nbColumns = N;
+	Desc.nbRows = N;
+	Desc.format = PxHeightFieldFormat::eS16_TM;
+	Desc.samples.data = Samples.GetData();
+	Desc.samples.stride = sizeof(PxHeightFieldSample);
+	Desc.flags = PxHeightFieldFlag::eNO_BOUNDARY_EDGES;
+	if (FParse::Param(FCommandLine::Get(), TEXT("FortniteLogLandscapeHeightfield")))
+	{
+		UE_LOG(LogLandscape, Warning, TEXT("Chaos->PhysX heightfield N=%d min=%f max=%f hpu=%f mirrored=%d materials=%d"),
+			N, Field.MinValue, Field.MaxValue, Field.HeightPerUnit, bIsMirrored ? 1 : 0, Field.NumMaterials);
+	}
+	static PxCooking* Cooking = PxCreateCooking(PX_PHYSICS_VERSION, *GPhysXFoundation, PxCookingParams(PxTolerancesScale()));
+	return Cooking ? Cooking->createHeightField(Desc, GPhysXSDK->getPhysicsInsertionCallback()) : nullptr;
+}
+
+static bool FortniteBuildPhysXHeightfieldsFromChaosBlob(const TArray<uint8>& Blob, int32 FullQuads,
+	int32 SimpleQuads, int32 PhysicalMaterialCount, bool bIsMirrored, PxHeightField*& OutFull, PxHeightField*& OutSimple)
+{
+	FFortniteHeightfieldCursor Cursor(Blob);
+	FFortniteChaosHeightfield Full, Simple;
+	bool bContainsSimple;
+	if (!Cursor.Boolean(bContainsSimple) ||
+		!Cursor.Check(SimpleQuads >= 0 && bContainsSimple == (SimpleQuads > 0), TEXT("component/simple stream disagreement")) ||
+		!FortniteReadChaosHeightfield(Cursor, FullQuads, 0, PhysicalMaterialCount, Full) ||
+		(bContainsSimple && !FortniteReadChaosHeightfield(Cursor, SimpleQuads, 1, PhysicalMaterialCount, Simple)) ||
+		!Cursor.Check(Cursor.Position == Blob.Num(), TEXT("trailing data/unsupported archive profile")))
+	{
+		UE_LOG(LogLandscape, Warning, TEXT("Rejected original Chaos landscape at byte %lld/%d: %s"), Cursor.Position, Blob.Num(), Cursor.Error);
+		return false;
+	}
+	// Validate the entire stream before cooking; publish neither object on failure.
+	PxHeightField* FullHeightfield = FortniteCookPhysXHeightfield(Full, bIsMirrored);
+	if (!FullHeightfield) return false;
+	PxHeightField* SimpleHeightfield = bContainsSimple ? FortniteCookPhysXHeightfield(Simple, bIsMirrored) : nullptr;
+	if (bContainsSimple && !SimpleHeightfield)
+	{
+		FullHeightfield->release();
+		return false;
+	}
+	OutFull = FullHeightfield;
+	OutSimple = SimpleHeightfield;
+	return true;
+}
