+#pragma once
+
+#include "CoreMinimal.h"
+
+class AActor;
+class UNetConnection;
+class UObject;
+class UFunction;
+
+// Called only from the server's existing RPC paths. No UObject is retained.
+namespace FortNetworkTrace
+{
+	bool IsEnabled();
+	void Record(const TCHAR* Event, const TCHAR* Outcome, const UNetConnection* Connection,
+		const UObject* Object, const UFunction* Function, const FName& FunctionName,
+		const AActor* Actor, int32 Channel, int32 PayloadBits);
+}
diff --git a/Engine/Source/Runtime/Engine/Private/FortNetworkTrace.cpp b/Engine/Source/Runtime/Engine/Private/FortNetworkTrace.cpp
new file mode 100644
--- /dev/null
+++ b/Engine/Source/Runtime/Engine/Private/FortNetworkTrace.cpp
@@ -0,0 +1,158 @@
+#include "FortNetworkTrace.h"
+#include "Engine/NetConnection.h"
+#include "Engine/World.h"
+#include "GameFramework/Actor.h"
+#include "HAL/FileManager.h"
+#include "HAL/Event.h"
+#include "HAL/PlatformProcess.h"
+#include "HAL/Runnable.h"
+#include "HAL/RunnableThread.h"
+#include "Misc/CommandLine.h"
+#include "Misc/CoreDelegates.h"
+#include "Misc/DateTime.h"
+#include "Misc/Parse.h"
+#include "Misc/Paths.h"
+#include "Misc/ScopeLock.h"
+#include "Serialization/JsonWriter.h"
+#include "Policies/CondensedJsonPrintPolicy.h"
+#include "Serialization/Archive.h"
+#include "UObject/Class.h"
+
+DEFINE_LOG_CATEGORY_STATIC(LogFortNetworkTrace, Log, All);
+
+namespace FortNetworkTrace
+{
+namespace
+{
+// Deliberately process-lifetime storage: the OnPreExit callback may run after
+// other static destructors. The worker and archive are closed at OnPreExit.
+class FRecorder final : public FRunnable
+{
+public:
+	FRecorder()
+	{
+		FString Path;
+		if (!FParse::Value(FCommandLine::Get(), TEXT("FortniteNetworkTrace="), Path)) return;
+		if (Path.IsEmpty() || FPaths::IsRelative(Path)) { Warn(TEXT("Network trace unavailable; tracing disabled.")); return; }
+		Archive = IFileManager::Get().CreateFileWriter(*Path);
+		if (!Archive) { Warn(TEXT("Network trace unavailable; tracing disabled.")); return; }
+		Wake = FPlatformProcess::GetSynchEventFromPool(false);
+		if (!Wake) { delete Archive; Archive = nullptr; Warn(TEXT("Network trace unavailable; tracing disabled.")); return; }
+		Thread = FRunnableThread::Create(this, TEXT("FortNetworkTrace"));
+		if (!Thread) { FPlatformProcess::ReturnSynchEventToPool(Wake); Wake = nullptr; delete Archive; Archive = nullptr; Warn(TEXT("Network trace unavailable; tracing disabled.")); return; }
+		bEnabled = true;
+		FCoreDelegates::OnPreExit.AddStatic(&FRecorder::OnPreExit);
+	}
+	bool Enabled() const { return bEnabled.Load(); }
+	void Append(const FString& Line)
+	{
+		FTCHARToUTF8 Utf8(*Line);
+		bool bOverflow = false;
+		{
+			FScopeLock Guard(&Lock);
+			if (!bEnabled.Load()) return;
+			if (int64(Buffer.Num()) + Utf8.Length() + 1 > MaxBufferBytes)
+			{
+				bEnabled.Store(false);
+				bOverflow = !bWarned.Exchange(true);
+				Wake->Trigger(); // Drain accepted records; do not accept this one.
+			}
+			else
+			{
+				Buffer.Append(reinterpret_cast<const uint8*>(Utf8.Get()), Utf8.Length());
+				Buffer.Add('\n');
+				if (++Count >= 128) Wake->Trigger();
+			}
+		}
+		if (bOverflow) UE_LOG(LogFortNetworkTrace, Warning, TEXT("Network trace buffer overflow; tracing disabled."));
+	}
+	virtual uint32 Run() override
+	{
+		for (;;)
+		{
+			Wake->Wait(1000);
+			TArray<uint8> Batch;
+			bool bShouldStop;
+			{
+				FScopeLock Guard(&Lock);
+				Swap(Batch, Buffer);
+				Count = 0;
+				bShouldStop = bStop;
+			}
+			if (Batch.Num() && Archive)
+			{
+				Archive->Serialize(Batch.GetData(), Batch.Num());
+				Archive->Flush();
+				if (Archive->IsError())
+				{
+					{
+						FScopeLock Guard(&Lock);
+						bEnabled.Store(false);
+						Buffer.Reset(); Count = 0;
+					}
+					Warn(TEXT("Network trace write failed; tracing disabled."));
+				}
+			}
+			if (bShouldStop) break;
+		}
+		return 0;
+	}
+	void Shutdown()
+	{
+		{
+			FScopeLock Guard(&Lock);
+			bEnabled.Store(false); bStop = true;
+			if (Wake) Wake->Trigger();
+		}
+		if (Thread) { Thread->WaitForCompletion(); delete Thread; Thread = nullptr; }
+		if (Archive) { Archive->Close(); if (Archive->IsError()) Warn(TEXT("Network trace close failed; tracing disabled.")); delete Archive; Archive = nullptr; }
+		if (Wake) { FPlatformProcess::ReturnSynchEventToPool(Wake); Wake = nullptr; }
+	}
+	static FRecorder& Get() { static FRecorder* Instance = new FRecorder(); return *Instance; }
+	static void OnPreExit() { Get().Shutdown(); }
+private:
+	void Warn(const TCHAR* Message) { if (!bWarned.Exchange(true)) UE_LOG(LogFortNetworkTrace, Warning, TEXT("%s"), Message); }
+	static constexpr int32 MaxBufferBytes = 1024 * 1024;
+	FCriticalSection Lock;
+	TArray<uint8> Buffer;
+	FArchive* Archive = nullptr;
+	FEvent* Wake = nullptr;
+	FRunnableThread* Thread = nullptr;
+	TAtomic<bool> bEnabled { false };
+	bool bStop = false;
+	TAtomic<bool> bWarned { false };
+	int32 Count = 0;
+};
+}
+
+bool IsEnabled() { return FRecorder::Get().Enabled(); }
+
+void Record(const TCHAR* Event, const TCHAR* Outcome, const UNetConnection* Connection,
+	const UObject* Object, const UFunction* Function, const FName& FunctionName,
+	const AActor* Actor, int32 Channel, int32 PayloadBits)
+{
+	FRecorder& Recorder = FRecorder::Get();
+	if (!Recorder.Enabled()) return;
+	const FDateTime Now = FDateTime::UtcNow();
+	const UWorld* World = Connection ? Connection->GetWorld() : nullptr;
+	FString Json;
+	auto Writer = TJsonWriterFactory<TCHAR, TCondensedJsonPrintPolicy<TCHAR>>::Create(&Json);
+	Writer->WriteObjectStart();
+	Writer->WriteValue(TEXT("schema_version"), 1);
+	Writer->WriteValue(TEXT("event"), Event);
+	Writer->WriteValue(TEXT("outcome"), Outcome);
+	Writer->WriteValue(TEXT("utc_unix_ms"), Now.ToUnixTimestamp() * 1000 + Now.GetMillisecond());
+	if (World) Writer->WriteValue(TEXT("world_time"), double(World->GetTimeSeconds())); else Writer->WriteNull(TEXT("world_time"));
+	Writer->WriteValue(TEXT("connection"), int64(Connection ? Connection->GetUniqueID() : 0));
+	Writer->WriteValue(TEXT("object_id"), int64(Object ? Object->GetUniqueID() : 0));
+	if (Object) Writer->WriteValue(TEXT("object_class"), Object->GetClass()->GetPathName()); else Writer->WriteNull(TEXT("object_class"));
+	if (Function && Function->GetOwnerClass()) Writer->WriteValue(TEXT("declaring_class"), Function->GetOwnerClass()->GetPathName()); else Writer->WriteNull(TEXT("declaring_class"));
+	Writer->WriteValue(TEXT("function"), FunctionName.ToString());
+	if (Actor) Writer->WriteValue(TEXT("actor_id"), int64(Actor->GetUniqueID())); else Writer->WriteNull(TEXT("actor_id"));
+	if (Channel >= 0) Writer->WriteValue(TEXT("channel"), Channel); else Writer->WriteNull(TEXT("channel"));
+	if (PayloadBits >= 0) Writer->WriteValue(TEXT("payload_bits"), PayloadBits); else Writer->WriteNull(TEXT("payload_bits"));
+	if (Function) Writer->WriteValue(TEXT("reliable"), bool(Function->FunctionFlags & FUNC_NetReliable)); else Writer->WriteNull(TEXT("reliable"));
+	Writer->WriteObjectEnd(); Writer->Close();
+	Recorder.Append(Json);
+}
+}
