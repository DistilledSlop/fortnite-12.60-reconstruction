// Unintegrated, uncounted recovery sketch. Types/names follow the adjacent
// stream-in draft and UE4.25/4.26; this is not a compilable replacement.
// The queue, allocation failure, deleting destructors, and base teardown must
// be resolved before integration. No assertions are inferred from UE source.

// The original vtable's AddRef (+8, 0x143ac8520) and GetRefCount
// (+0x18, 0x1445eb510) operate on +0x5c. Use the inherited final
// FRenderAssetUpdate implementations; no derived overrides are declared.

// 0x1445dc620, vtable +0x20. TS_Done is numeric zero in this capture;
// bIsCancelled is at +0x54, task state +0x58, IORequests at +0x190.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::Abort()
{
    if (bIsCancelled || TaskState == 0)
        return;
    bIsCancelled = true;
    for (int32 Index = 0; Index < 8; ++Index)
    {
        if (IORequests[Index])
        {
            // Matches UE4.25 FAutoDeleteAsyncTask::StartBackgroundTask:
            // queue through GThreadPool, or execute synchronously if null.
            // Capture does not recover the register passed to the fallback
            // 0x1445e7300; allocation failure behavior also remains unresolved.
            (new FAutoDeleteAsyncTask<FCancelIORequestsTask>(this))->StartBackgroundTask();
            return;
        }
    }
}

// User task embedded in FAutoDeleteAsyncTask. TRefCountPtr takes the
// reference seen during construction and releases it upon task destruction.
class FCancelIORequestsTask : public FNonAbandonableTask
{
    TRefCountPtr<FLandscapeMeshMobileStreamIn_IO_AsyncReallocate> PendingUpdate;
public:
    explicit FCancelIORequestsTask(FLandscapeMeshMobileStreamIn_IO_AsyncReallocate* Update)
        : PendingUpdate(Update) {}
    void DoWork()
    {
        auto PreviousState = PendingUpdate->DoLock();
        for (int32 Index = 0; Index < 8; ++Index)
            if (PendingUpdate->IORequests[Index])
                PendingUpdate->IORequests[Index]->Cancel(); // request vtable +0x28
        PendingUpdate->DoUnlock(PreviousState);
    }
    // GetStatId required by FAutoDeleteAsyncTask; exact stat identity unresolved.
};

// Original wrapper 0x1445dc570 -> 0x1445e7300 performs the work and
// invokes its deleting destructor with flag 1. 0x1445db6e0 releases the
// held reference through 0x1445f0430 (mapped to Release), installs base
// vtable 0x145ad37f8, and frees 0x10 bytes if flags & 1.
// 0x1445dbcd0 installs 0x146b39a28, calls 0x1445d8550(this), then if
// flags & 1 calls 0x142bee710(this, 0x220), inferred free; returns this.
// 0x1445d8550 switches vtables, destroys callback storage, releases the
// intermediate RHI reference at +0x108, and calls 0x1445d83d0. The latter
// destroys two more callback containers and the +0x10 critical section,
// matching the inherited UE4.25 update teardown. Exact callback types and
// derived/base layout remain integration dependencies.
