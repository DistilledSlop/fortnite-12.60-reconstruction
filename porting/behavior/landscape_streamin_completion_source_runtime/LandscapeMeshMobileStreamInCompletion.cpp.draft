// Unintegrated, uncounted 12.60 source recovery. This extends the class in
// landscape_streamin_source_runtime; it is not a standalone translation unit.
// Proxy cached-resident access and mobile render data are integration dependencies.

// Original 0x1445e4960, reached by closure 0x1445dfcd0.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoGetIORequestResults(const FContext& Context)
{
    if (!IsCancelled() && Context.LandscapeProxy && Context.RenderData)
    {
        for (int32 Index = PendingFirstMip; Index < CurrentFirstLODIdx; ++Index)
        {
            IBulkDataIORequest* Request = IORequests[Index];
            if (Request)
            {
                IORequests[Index] = nullptr;
                while (!Request->PollCompletion())
                {
                    FPlatformProcess::Sleep(0.000001f);
                }
                StagingLODDataArray[Index] = Request->GetReadResults();
                StagingLODDataSizes[Index] = Request->GetSize();
                delete Request;
            }
        }
    }
    ClearIORequest(Context); // 0x1445e0c50
    PushTask(Context, TT_Render, SRA_UPDATE_CALLBACK(DoExpandResources),
        Context.GetCurrentThread(), SRA_UPDATE_CALLBACK(DoCancel));
}

// Original 0x1445da650, reached by closure 0x1445dfab0. The capture's
// first argument is closure storage containing this, not this directly.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoCancelIO(const FContext& Context)
{
    ClearIORequest(Context); // 0x1445e0c50
    PushTask(Context, TT_None, nullptr,
        Context.GetCurrentThread(), SRA_UPDATE_CALLBACK(DoCancel));
}

// Original 0x1445e0c50. Context is unused in the binary; the parameter
// keeps the signature consistent with the corresponding 4.26 helper.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::ClearIORequest(const FContext& Context)
{
    for (int32 Index = PendingFirstMip; Index < CurrentFirstLODIdx; ++Index)
    {
        IBulkDataIORequest*& Request = IORequests[Index];
        if (Request)
        {
            if (!Request->PollCompletion())
            {
                Request->Cancel();
                Request->WaitCompletion(0.0f);
            }
            delete Request;
            Request = nullptr;
        }
    }
}

// Original 0x1445d99b0, reached by closure 0x1445df9a0.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoExpandResources(const FContext& Context)
{
    ExpandResources(Context); // 0x1445e8fe0
    PushTask(Context, TT_Render, SRA_UPDATE_CALLBACK(DoFinishUpdate),
        Context.GetCurrentThread(), SRA_UPDATE_CALLBACK(DoCancel));
}

// Original 0x1445e35e0, reached by closure 0x1445df910. Free is inferred
// from the UE analogue and the allocator callee 0x142bee710.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoCancel(const FContext& Context)
{
    for (int32 Index = 0; Index < 8; ++Index)
    {
        FMemory::Free(StagingLODDataArray[Index]);
        StagingLODDataArray[Index] = nullptr;
        StagingLODDataSizes[Index] = 0;
    }
    DoFinishUpdate(Context); // 0x1445e44a0
}

// Original 0x1445e8fe0. Buffer creation, lock, unlock and queued copy are
// expressed using the 4.25/4.26 RHI API corresponding to captured RHI calls.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::ExpandResources(const FContext& Context)
{
    FLandscapeMobileRenderData* RenderData = Context.RenderData;
    if (!IsCancelled() && Context.LandscapeProxy && RenderData)
    {
        const uint32 OldSize = RenderData->VertexBuffer->VertexBufferRHI->GetSize();
        uint32 NewSize = OldSize;
        for (int32 Index = CurrentFirstLODIdx - 1; Index >= PendingFirstMip; --Index)
        {
            NewSize += StagingLODDataSizes[Index];
        }
        if (NewSize != OldSize)
        {
            FRHIResourceCreateInfo CreateInfo;
            IntermediateVertexBuffer = RHICreateVertexBuffer(NewSize, BUF_Static, CreateInfo);
            uint8* Dest = static_cast<uint8*>(RHILockVertexBuffer(IntermediateVertexBuffer, OldSize, NewSize - OldSize, RLM_WriteOnly));
            for (int32 Index = CurrentFirstLODIdx - 1; Index >= PendingFirstMip; --Index)
            {
                if (StagingLODDataSizes[Index] > 0)
                {
                    FMemory::Memcpy(Dest, StagingLODDataArray[Index], StagingLODDataSizes[Index]);
                    Dest += StagingLODDataSizes[Index];
                    FMemory::Free(StagingLODDataArray[Index]);
                    StagingLODDataArray[Index] = nullptr;
                    StagingLODDataSizes[Index] = 0;
                }
            }
            RHIUnlockVertexBuffer(IntermediateVertexBuffer);
            FRHICommandListExecutor::GetImmediateCommandList().CopyBufferRegion(
                IntermediateVertexBuffer, 0, RenderData->VertexBuffer->VertexBufferRHI, 0, OldSize);
        }
    }
}

// Original 0x1445e44a0, reached by closure 0x1445dfb40 and DoCancel.
void FLandscapeMeshMobileStreamIn_IO_AsyncReallocate::DoFinishUpdate(const FContext& Context)
{
    ULandscapeLODStreamingProxy* Proxy = const_cast<ULandscapeLODStreamingProxy*>(Context.LandscapeProxy);
    FLandscapeMobileRenderData* RenderData = Context.RenderData;
    if (!IsCancelled() && Proxy && RenderData)
    {
        if (IntermediateVertexBuffer)
        {
            FLandscapeVertexBufferMobile* VertexBuffer = RenderData->VertexBuffer;
            FLandscapeVertexBufferMobile::UpdateMemoryStat(IntermediateVertexBuffer->GetSize() - VertexBuffer->VertexBufferRHI->GetSize());
            TRHIResourceUpdateBatcher<1> Batcher;
            Batcher.QueueUpdateRequest(VertexBuffer->VertexBufferRHI, IntermediateVertexBuffer);
        }
        RenderData->CurrentFirstLODIdx = static_cast<uint8>(PendingFirstMip);
        Proxy->CachedNumResidentLODs = static_cast<uint8>(Proxy->GetNumMipsForStreaming() - PendingFirstMip);
    }
    IntermediateVertexBuffer.SafeRelease();
}
