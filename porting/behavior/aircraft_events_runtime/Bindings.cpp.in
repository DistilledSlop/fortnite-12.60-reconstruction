// Fragments only: insert at the recovered binding sites in their complete owners.
// Aircraft is the aircraft being initialized; this is AFortGameModeAthena.
FScriptDelegate AircraftBinding;
AircraftBinding.BindUFunction(this, FName(TEXT("OnAircraftEnteredDropZone")));
Aircraft->NativeAircraftEnteredDropZone.Add(AircraftBinding);
AircraftBinding.BindUFunction(this, FName(TEXT("OnAircraftExitedDropZone")));
Aircraft->NativeAircraftExitedDropZone.Add(AircraftBinding);
AircraftBinding.BindUFunction(this, FName(TEXT("OnAircraftFlightEnded")));
Aircraft->NativeAircraftFlightEnded.Add(AircraftBinding);

// Separate AFortAthenaMutator_SpecialEvent site, with its actual aircraft member.
FScriptDelegate AircraftBinding;
AircraftBinding.BindUFunction(this, FName(TEXT("OnAircraftEnteredDropZone")));
Aircraft->NativeAircraftEnteredDropZone.AddUnique(AircraftBinding);
AircraftBinding.BindUFunction(this, FName(TEXT("OnAircraftExitedDropZone")));
Aircraft->NativeAircraftExitedDropZone.AddUnique(AircraftBinding);
AircraftBinding.BindUFunction(this, FName(TEXT("OnAircraftFlightEnded")));
Aircraft->NativeAircraftFlightEnded.AddUnique(AircraftBinding);
