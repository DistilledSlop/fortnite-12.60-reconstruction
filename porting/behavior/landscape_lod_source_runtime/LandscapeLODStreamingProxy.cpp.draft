// Original 12.60 source counterpart, integration draft; not compiled.
// Requires the original mobile landscape platform data and proxy declarations.
// The member names below follow the corresponding mobile types in UE 4.26;
// the implementations and the old UStreamableRenderAsset API follow 12.60.

ULandscapeLODStreamingProxy::ULandscapeLODStreamingProxy(const FObjectInitializer& ObjectInitializer)
    : Super(ObjectInitializer)
    , LandscapeComponent(Cast<ULandscapeComponent>(GetOuter()))
{
    CachedNumResidentLODs = 1;
}

int32 ULandscapeLODStreamingProxy::CalcCumulativeLODSize(int32 NumLODs) const
{
    const auto& LODs = LandscapeComponent->PlatformData.StreamingLODDataArray;
    int64 Size = 0;
    for (int32 Index = LODs.Num() - 1; Index >= LODs.Num() - NumLODs + 1; --Index)
    {
        Size += static_cast<uint32>(LODs[Index].GetBulkDataSize());
    }
    return static_cast<int32>(Size);
}

int32 ULandscapeLODStreamingProxy::GetNumMipsForStreaming() const
{
    return LandscapeComponent->PlatformData.StreamingLODDataArray.Num() + 1;
}

bool ULandscapeLODStreamingProxy::GetMipDataFilename(int32 MipIndex, FString& OutBulkDataFilename) const
{
    const auto& PlatformData = LandscapeComponent->PlatformData;
    if (MipIndex < 0 || MipIndex >= PlatformData.StreamingLODDataArray.Num())
    {
        return false;
    }
    OutBulkDataFilename = PlatformData.CachedLODDataFileName;
    return true;
}

bool ULandscapeLODStreamingProxy::IsReadyForStreaming() const
{
    return LandscapeComponent->PlatformData.CachedRenderData.IsValid();
}

int32 ULandscapeLODStreamingProxy::GetNumResidentMips() const
{
    const auto& PlatformData = LandscapeComponent->PlatformData;
    const int32 FirstLOD = PlatformData.CachedRenderData.IsValid()
        ? PlatformData.CachedRenderData->CurrentFirstLODIdx
        : PlatformData.StreamingLODDataArray.Num();
    return GetNumMipsForStreaming() - FirstLOD;
}

int32 ULandscapeLODStreamingProxy::GetNumRequestedMips() const
{
    return PendingUpdate && !PendingUpdate->IsCancelled()
        ? PendingUpdate->GetNumRequestedMips() : CachedNumResidentLODs;
}

bool ULandscapeLODStreamingProxy::CancelPendingMipChangeRequest()
{
    if (!PendingUpdate)
    {
        return false;
    }
    if (!PendingUpdate->IsCancelled())
    {
        PendingUpdate->Abort();
    }
    return true;
}

bool ULandscapeLODStreamingProxy::HasPendingUpdate() const
{
    return !!PendingUpdate;
}

bool ULandscapeLODStreamingProxy::IsPendingUpdateLocked() const
{
    return PendingUpdate && PendingUpdate->IsLocked();
}

bool ULandscapeLODStreamingProxy::UpdateStreamingStatus(bool bWaitForMipFading)
{
    if (PendingUpdate)
    {
        if (IsEngineExitRequested() || !LandscapeComponent->PlatformData.CachedRenderData.IsValid())
        {
            PendingUpdate->Abort();
        }
        FRenderAssetUpdate::EThreadType TickThread = GIsThreadedRendering
            ? FRenderAssetUpdate::TT_None : FRenderAssetUpdate::TT_Render;
        if (HasAnyFlags(RF_BeginDestroyed) && PendingUpdate->GetRelevantThread() == FRenderAssetUpdate::TT_Async)
        {
            TickThread = FRenderAssetUpdate::TT_GameRunningAsync;
        }
        PendingUpdate->Tick(TickThread);
        if (!PendingUpdate->IsCompleted())
        {
            return true;
        }
        PendingUpdate.SafeRelease();
    }
    return false;
}
