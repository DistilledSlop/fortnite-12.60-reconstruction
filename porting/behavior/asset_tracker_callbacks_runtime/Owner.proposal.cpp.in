// Integration proposal, not a production implementation. HandleLoadPackage is
// intentionally only declared: its real implementation is required and is
// described in ../fort_assets_diagnostics_runtime/HANDOFF.md. The two path
// maps' element types are supported by read evidence; their key policy and
// writers remain unverified. No new singleton should be registered until these
// outstanding pieces and the integration's ABI are checked.
class FFortAssets : public FGCObject
{
public:
    static FFortAssets& Get()
    {
        static FFortAssets Instance;
        return Instance;
    }

    FFortAssets();
    ~FFortAssets();
    virtual void AddReferencedObjects(FReferenceCollector& Collector) override;
    virtual FString GetReferencerName() const override { return TEXT("FFortAssets"); }

    void TrackAsset(UObject* Object);
    int32 RemovePostStartupAsset(UObject* Object);
    void AddTemporaryReference(UObject* Object, FName Name);
    void ClearTemporaryAssets(); // also called inside changed-submode transition
    static void SetStartupWindowClosedForAlwaysLoadedAssets(bool bClosed);

private:
    void HandlePreLoadMap(const FString& MapName);
    void HandleLoadPackage(const FString& Path, bool bSync); // no stub

    TMap<FSoftObjectPath, int32> DiagnosticAt10;
    TMap<FSoftObjectPath, int32> DiagnosticAt60;
    TSet<UObject*> AlwaysLoadedAssets;
    TSet<UObject*> PostStartupAssets;
    TMap<UObject*, FName> TemporaryReferences;
    FCriticalSection CriticalSection;
    bool bStartupWindowClosedForAlwaysLoadedAssets = false;
    double LastLoadTime = 0;
    FString LastLoadPath;
    int32 AthenaLoadIssueCount = 0;
    int32 CampaignLoadIssueCount = 0;
};

FFortAssets::FFortAssets()
{
    FCoreUObjectDelegates::PreLoadMap.AddRaw(this, &FFortAssets::HandlePreLoadMap);
    FCoreDelegates::OnSyncLoadPackage.AddRaw(this, &FFortAssets::HandleLoadPackage, true);
}

FFortAssets::~FFortAssets()
{
    FCoreUObjectDelegates::PreLoadMap.RemoveAll(this);
    FCoreDelegates::OnAsyncLoadingFlush.RemoveAll(this);
    FCoreDelegates::OnAsyncLoadPackage.RemoveAll(this);
    FCoreDelegates::OnSyncLoadPackage.RemoveAll(this);
}

void FFortAssets::TrackAsset(UObject* Object)
{
    FScopeLock Lock(&CriticalSection);
    if (!bStartupWindowClosedForAlwaysLoadedAssets)
        AlwaysLoadedAssets.Add(Object);
    else if (!AlwaysLoadedAssets.Contains(Object))
        PostStartupAssets.Add(Object);
}

int32 FFortAssets::RemovePostStartupAsset(UObject* Object)
{
    return PostStartupAssets.Remove(Object); // original is unlocked
}

void FFortAssets::AddTemporaryReference(UObject* Object, FName Name)
{
    if (Object)
        TemporaryReferences.Add(Object, Name); // original is unlocked
}

void FFortAssets::AddReferencedObjects(FReferenceCollector& Collector)
{
    {
        FScopeLock Lock(&CriticalSection);
        Collector.AddReferencedObjects(AlwaysLoadedAssets);
        Collector.AddReferencedObjects(PostStartupAssets);
    }
    Collector.AddReferencedObjects(TemporaryReferences); // original is unlocked
}

void FFortAssets::ClearTemporaryAssets()
{
    FScopeLock Lock(&CriticalSection);
    PostStartupAssets.Empty(0);
    TemporaryReferences.Empty(0);
}

void FFortAssets::HandlePreLoadMap(const FString&)
{
    ClearTemporaryAssets();
}

void FFortAssets::SetStartupWindowClosedForAlwaysLoadedAssets(bool bClosed)
{
    FFortAssets& Assets = Get();
    FScopeLock Lock(&Assets.CriticalSection);
    if (Assets.bStartupWindowClosedForAlwaysLoadedAssets == bClosed)
    {
        UE_LOG(LogFort, Error, TEXT("SetStartupWindowClosedForAlwaysLoadedAssets called with already set value!"));
    }
    else
        Assets.bStartupWindowClosedForAlwaysLoadedAssets = bClosed;
}
