// Source-level reconstruction; integration requires the typed binding contract in README.md.
// These names are descriptive, not recovered original symbol names.
struct FMutatorIteratorBindings
{
    // These calls retain native interface/virtual dispatch, including their side effects.
    static void AppendContextOwners(IFortMutatorContext*, TArray<UObject*>&);
    static UObject* FindVolumeOwnerForContext(UObject* Context); // 141c74820 -> 141c7c5c0
    static void AppendOwnerMutators(IFortMutatorOwner*, TArray<AFortGameplayMutator*>&, UObject* Context);
    static UFortMutatorListComponent* FindMutatorListComponent(UObject* Owner); // virtual +610
    static void SetMutatorContext(AFortAthenaMutator*, UObject* Context); // virtual +6b8
    static uint8 QueryInfiniteAmmo(AFortAthenaMutator*, bool& Out, UFortWeaponItemDefinition*); // +9b8
};

class FRecoveredMutatorIterator
{
    TArray<UObject*> Owners;
    TWeakObjectPtr<UObject> Context;
    int32 OwnerIndex = 0;
    int32 CandidateIndex = 0;
    TArray<AFortGameplayMutator*> Candidates;
    AFortAthenaMutator* Current = nullptr;
    bool bActiveOnly;

    void SelectOwner(int32 Index)
    {
        OwnerIndex = Index;
        if (!Owners.IsValidIndex(Index)) { Current = nullptr; return; }
        Candidates.Reset();
        UObject* Owner = Owners[Index];
        if (Owner)
        {
            if (IFortMutatorOwner* Interface = Cast<IFortMutatorOwner>(Owner))
                FMutatorIteratorBindings::AppendOwnerMutators(Interface, Candidates, Context.Get());
            else if (UFortMutatorListComponent* Component = FMutatorIteratorBindings::FindMutatorListComponent(Owner))
                Candidates.Append(Component->Mutators);
        }
        if (Candidates.Num() == 0) SelectOwner(OwnerIndex + 1);
        else SelectCandidate(0);
    }
    void SelectCandidate(int32 Index)
    {
        for (;;)
        {
            CandidateIndex = Index;
            if (Current) FMutatorIteratorBindings::SetMutatorContext(Current, nullptr);
            // Re-read the index: a virtual callback can alter iterator state.
            Index = CandidateIndex;
            if (!Candidates.IsValidIndex(Index)) { SelectOwner(OwnerIndex + 1); return; }
            Current = Cast<AFortAthenaMutator>(Candidates[Index]);
            if (Current && (!bActiveOnly || Current->bMutatorActiveInternal || Current->bMutatorActive))
            {
                FMutatorIteratorBindings::SetMutatorContext(Current, Context.Get());
                return;
            }
            Index = CandidateIndex + 1;
        }
    }
public:
    FRecoveredMutatorIterator(UObject* InContext, UObject* ExtraOwner, bool ActiveOnly)
        : Context(InContext), bActiveOnly(ActiveOnly)
    {
        if (InContext)
        {
            if (IFortMutatorContext* Interface = Cast<IFortMutatorContext>(InContext))
                FMutatorIteratorBindings::AppendContextOwners(Interface, Owners);
            else if (UObject* Owner = FMutatorIteratorBindings::FindVolumeOwnerForContext(InContext))
                Owners.AddUnique(Owner);
        }
        if (ExtraOwner) Owners.AddUnique(ExtraOwner);
        SelectOwner(OwnerIndex);
    }
    ~FRecoveredMutatorIterator()
    {
        if (Current) { FMutatorIteratorBindings::SetMutatorContext(Current, nullptr); Current = nullptr; }
    }
    AFortAthenaMutator* Get() const { return Current; }
    void Advance() { SelectCandidate(CandidateIndex + 1); }
};

bool RecoveredInfiniteAmmo(AFortGameStateAthena* GameState, AFortPlayerStateAthena* PlayerState,
                           UFortWeaponItemDefinition* WeaponDefinition)
{
    bool Result = false;
    FRecoveredMutatorIterator It(PlayerState, GameState, true);
    while (AFortAthenaMutator* Mutator = It.Get())
    {
        bool Value = false;
        uint8 Control = FMutatorIteratorBindings::QueryInfiniteAmmo(Mutator, Value, WeaponDefinition);
        Result |= Value;
        if (Control == 2) break;
        It.Advance();
    }
    return Result;
}
