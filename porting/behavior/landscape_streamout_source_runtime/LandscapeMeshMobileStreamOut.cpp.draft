// Unintegrated source draft for the original 12.60 stream-out scheduling path.
// Context constructors and the mobile render data remain integration dependencies.
// The proxy must grant this class access to its cached resident byte.
#include "RenderAssetUpdate.h"
#include "LandscapeComponent.h"
#include "LandscapeRenderMobile.h"
#include "RHICommandList.h"
#include "Streaming/RenderAssetUpdate.inl"

class ULandscapeLODStreamingProxy;
struct FLandscapeMobileRenderData;

struct FLandscapeMeshMobileUpdateContext
{
    using EThreadType = FRenderAssetUpdate::EThreadType;
    FLandscapeMeshMobileUpdateContext(const ULandscapeLODStreamingProxy* Proxy, EThreadType Thread);
    FLandscapeMeshMobileUpdateContext(const UStreamableRenderAsset* Proxy, EThreadType Thread);
    EThreadType GetCurrentThread() const { return CurrentThread; }

    const ULandscapeLODStreamingProxy* LandscapeProxy;
    FLandscapeMobileRenderData* RenderData;
    EThreadType CurrentThread;
};

class FLandscapeMeshMobileUpdate : public TRenderAssetUpdate<FLandscapeMeshMobileUpdateContext>
{
public:
    FLandscapeMeshMobileUpdate(ULandscapeLODStreamingProxy* Proxy, int32 RequestedMips);
protected:
    virtual ~FLandscapeMeshMobileUpdate() = default;
    int32 CurrentFirstLODIdx;
};

class FLandscapeMeshMobileStreamOut : public FLandscapeMeshMobileUpdate
{
public:
    FLandscapeMeshMobileStreamOut(ULandscapeLODStreamingProxy* Proxy, int32 RequestedMips);
private:
    // Wrapper 0x1445df960 forwards its context to 0x1445f4db0.
    void ShrinkResources(const FContext& Context);
};

// Original 0x1445d5880. The base FRenderAssetUpdate constructor is the
// 4.25-era contract matches the recovered original callee 0x1445d6490.
FLandscapeMeshMobileUpdate::FLandscapeMeshMobileUpdate(
    ULandscapeLODStreamingProxy* Proxy, int32 RequestedMips)
    : TRenderAssetUpdate<FLandscapeMeshMobileUpdateContext>(Proxy, RequestedMips)
{
    TSharedPtr<FLandscapeMobileRenderData, ESPMode::ThreadSafe> RenderData = Proxy->GetRenderData();
    if (!RenderData.IsValid())
    {
        PendingFirstMip = INDEX_NONE;
        this->RequestedMips = INDEX_NONE;
        bIsCancelled = true;
        CurrentFirstLODIdx = INDEX_NONE;
    }
    else
    {
        CurrentFirstLODIdx = RenderData->CurrentFirstLODIdx;
    }
}

// Original 0x1445d5620. PushTask is inlined in the capture: thread 1,
// callback bound to this, cancellation thread 0, null cancellation callback.
FLandscapeMeshMobileStreamOut::FLandscapeMeshMobileStreamOut(
    ULandscapeLODStreamingProxy* Proxy, int32 RequestedMips)
    : FLandscapeMeshMobileUpdate(Proxy, RequestedMips)
{
    PushTask(FContext(Proxy, TT_None), TT_Render,
        SRA_UPDATE_CALLBACK(ShrinkResources), TT_None, nullptr);
}

// Original 0x1445f4db0. The proxy friend/accessor must preserve direct cached
// byte reads and writes even in editor builds, unlike the 4.25 public accessors.
void FLandscapeMeshMobileStreamOut::ShrinkResources(const FContext& Context)
{
    ULandscapeLODStreamingProxy* Proxy = const_cast<ULandscapeLODStreamingProxy*>(Context.LandscapeProxy);
    FLandscapeMobileRenderData* RenderData = Context.RenderData;
    if (!IsCancelled() && Proxy && RenderData)
    {
        const uint8 OldResidentLODs = Proxy->CachedNumResidentLODs;
        RenderData->CurrentFirstLODIdx = static_cast<uint8>(PendingFirstMip);
        const uint8 NewResidentLODs = static_cast<uint8>(Proxy->GetNumMipsForStreaming() - PendingFirstMip);
        Proxy->CachedNumResidentLODs = NewResidentLODs;

        const int32 OldSize = Proxy->CalcCumulativeLODSize(OldResidentLODs);
        const int32 NewSizeWithoutInline = Proxy->CalcCumulativeLODSize(NewResidentLODs);
        const int32 SizeDelta = NewSizeWithoutInline - OldSize;
        if (SizeDelta != 0)
        {
            FLandscapeVertexBufferMobile::UpdateMemoryStat(SizeDelta);
            FRHIVertexBuffer* OldBuffer = RenderData->VertexBuffer->VertexBufferRHI;
            const int32 NewSize = static_cast<int32>(OldBuffer->GetSize()) + SizeDelta;
            FRHIResourceCreateInfo CreateInfo;
            FVertexBufferRHIRef NewBuffer = RHICreateVertexBuffer(NewSize, BUF_Static, CreateInfo);
            FRHICommandListExecutor::GetImmediateCommandList().CopyBufferRegion(NewBuffer, 0, OldBuffer, 0, NewSize);
            TRHIResourceUpdateBatcher<1> Batcher;
            Batcher.QueueUpdateRequest(OldBuffer, NewBuffer);
        }
    }
}
