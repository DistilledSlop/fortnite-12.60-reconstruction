# Track only work created for the Linux port. The supplied Fortnite tree stays local.
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/porting/

# Generated output, build products, and temporary files.
/porting/generated/
/porting/build/
/porting/.venv/
/porting/native/Binaries/
/porting/native/Intermediate/
/porting/native/Saved/
/porting/native/DerivedDataCache/
**/__pycache__/
**/bin/
**/obj/
*.pyc
*.log
