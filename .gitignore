# Track only work created for the Linux port. The supplied Fortnite tree stays local.
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/porting/

# Generated output, build products, and temporary files.
/porting/generated/
/porting/build/
/porting/.venv/
/porting/native/Binaries/
/porting/native/Intermediate/
/porting/native/Saved/
/porting/native/DerivedDataCache/
/porting/native/Content/**
!/porting/native/Content/.gitkeep
**/__pycache__/
**/bin/
**/obj/
*.pyc
*.log

# Port progress dashboard: rendered pages and the per-commit history are regenerated locally.
/porting/progress/out/
/porting/progress/history.json
/porting/native/Plugins/Water/

# Regenerated in about 5 s by porting/behavior/build_vtable_slots.py (2.8 MB)
porting/behavior/vtable_slots.json
