#!/usr/bin/env python3
"""Reject accidental commits of the supplied game or binary assets."""

import subprocess
import sys


allowed_exact = {".gitignore", ".gitattributes", ".githooks/pre-commit"}
forbidden_directories = ("porting/generated/", "porting/build/", "porting/.venv/")
forbidden_suffixes = {
    ".pak", ".sig", ".exe", ".dll", ".so", ".dylib", ".uasset",
    ".umap", ".ubulk", ".uexp", ".mp4", ".wav", ".png", ".jpg",
    ".bin", ".zip", ".7z", ".rar", ".uproject", ".uplugin",
    ".upluginmanifest", ".usmap", ".locres", ".archive",
}

entries = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"]
).split(b"\0")
errors = []
for raw in filter(None, entries):
    path = raw.decode("utf-8", "surrogateescape")
    if path not in allowed_exact and not path.startswith("porting/"):
        errors.append(f"outside porting allowlist: {path}")
    if path.startswith(forbidden_directories):
        errors.append(f"generated or build output: {path}")
    if any(path.lower().endswith(suffix) for suffix in forbidden_suffixes):
        errors.append(f"binary asset extension: {path}")
    try:
        size = int(subprocess.check_output(["git", "cat-file", "-s", ":" + path]))
    except subprocess.CalledProcessError:
        continue
    if size > 10 * 1024 * 1024:
        errors.append(f"over 10 MiB: {path}")

if errors:
    print("Commit blocked to protect supplied files:", file=sys.stderr)
    for error in errors:
        print(f"  {error}", file=sys.stderr)
    sys.exit(1)
