#!/bin/sh
# Regenerate the port progress dashboard after each commit and append the
# commit's history point. Finish the refresh before the hook returns so process
# cleanup cannot discard a detached job. Never fail the commit.
#
# On main it also republishes README.md and docs/ (publish.py) in the working
# tree. It does not commit them: include README.md and docs/ in the next regular
# commit so the GitHub README stays current without one commit per refresh.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
gen="$root/porting/generated"
mkdir -p "$gen" 2>/dev/null || exit 0
log="$gen/progress-hook.log"
(cd "$root" && python3 -I porting/progress/progress.py) >>"$log" 2>&1 </dev/null || :

[ "$(git -C "$root" symbolic-ref --short -q HEAD)" = "main" ] || exit 0
gitdir=$(git -C "$root" rev-parse --git-dir)
for s in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  [ -e "$gitdir/$s" ] && exit 0
done

(cd "$root" && python3 -I porting/progress/publish.py) >>"$log" 2>&1 </dev/null || :
exit 0
